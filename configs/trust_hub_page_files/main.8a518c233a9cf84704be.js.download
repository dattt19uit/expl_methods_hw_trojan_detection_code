em \xe0s] LT",lastWeek:function(){return 0===this.day()||6===this.day()?"[\xdaltimo] dddd [\xe0s] LT":"[\xdaltima] dddd [\xe0s] LT"},sameElse:"L"},relativeTime:{future:"em %s",past:"h\xe1 %s",s:"poucos segundos",ss:"%d segundos",m:"um minuto",mm:"%d minutos",h:"uma hora",hh:"%d horas",d:"um dia",dd:"%d dias",M:"um m\xeas",MM:"%d meses",y:"um ano",yy:"%d anos"},dayOfMonthOrdinalParse:/\d{1,2}\xba/,ordinal:"%d\xba",invalidDate:"Data inv\xe1lida"})}(n("wd/R"))},"1gfc":function(e){e.exports=JSON.parse('[{"category":"Side Channel Analysis","vulnerability-attack":"Pre-Silicon Power Side-channel assessment","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Pre-Silicon Power Side-channel assessment","security-metric-description":null,"trl":"3","description":["At the RTL stage, the RTL-PAT (RTL-Power Analysis Tool) framework enables technology-independent PSC evaluation of cryptographic cores. Assessing the RTL gives designers the most freedom in immediately implementing countermeasures. RTL-PAT can also be used as a front-end sign-off framework for PSC leaks, allowing a designer to make modifications early in the design process that would be difficult or time-consuming to accomplish in subsequent design stages. RTL-PAT is also capable of analyzing FPGA, and ASIC design flows for standalone IPs and SoCs."],"links":["https://www.trust-hub.org/downloads/ipsolutions/RTL-PAT.zip"],"contacts":[{"name":"Mark Tehranipoor","email":"tehranipoor@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Farimah Farahmandi","email":"farimah@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Jungmin Park","email":"juminpark@ufl.edu","affiliation":"University of Florida"},{"name":"Nitin Pundir","email":"nitin.pundir@ufl.edu","affiliation":"University of Florida"}],"affiliation":"University of Florida"},{"category":"Information Leakage","vulnerability-attack":"PSC-TG: RTL Power Side-Channel Leakage Assessment with Test Pattern Generation","solution-plugin":" N/A ","solution-status":" unknown ","licensing":"N/A","security-metric":" N/A ","security-metric-description":null,"trl":"Not Available","description":[""],"links":["https://www.trust-hub.org/downloads/cadsolutions/Camera_Ready_Version_PSCTG.pdf","https://www.trust-hub.org/downloads/cadsolutions/PSC_TG_Tool1218.tar.gz"],"contacts":[{"name":"Farimah Farahmandi","email":"farimah@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Jungmin Park","email":"jungminpark@ufl.edu","affiliation":"University of Florida"},{"name":"Mark Tehranipoor","email":"tehranipoor@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Tao Zhang","email":"tao.zhang@ufl.edu","affiliation":"University of Florida"}],"affiliation":"Department of Electrical and Computer Engineering, University of Florida"},{"category":"Information Leakage","vulnerability-attack":"Violation of information flow security policies due to design mistakes and/or CAD tools","solution-plugin":"Incorporate to conventional ASIC design flow to asses vulnerabilities due to violation of IFS policies at design stage","solution-status":"Commercial or academic tool","licensing":"Academic License ","security-metric":"Confidentiality Verification (asset leakage) and Integrity Verification (asset tampering)","security-metric-description":null,"trl":"Not Available","description":["The tool models an asset (e.g., a net carrying a secret key) as a stuck-at-0 and stuck-at-1 fault and utilizes the automatic test pattern generation (ATPG) algorithm to detect that faults. A successful detection of faults means that the logical value of the asset carrying net can be observed through the observe points or logical value of the asset can be controlled by the control points. The tool works at a gate level netlist."],"links":["https://fics.institute.ufl.edu/"],"contacts":[{"name":"Mark Tehranipoor","email":"tehranipoor@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Domenic Forte","email":"dforte@ece.ufl.edu","affiliation":"University of Florida"}],"affiliation":"FICS Research, University of Florida"},{"category":"Information Leakage","vulnerability-attack":"Information leakage, access control, memory protection, key management","solution-plugin":"Plug-in to existing simulation and regression environments (UVM, OVM, testbench, etc.)","solution-status":"Commercial or academic tool","licensing":"Annual License fee","security-metric":"Information Leakage","security-metric-description":"Detects leakages that relate to confidentiality or integrity violations in the system","trl":"Not Available","description":["Radix-S employs patented technology to detect and prevent security vulnerabilities in FPGAs, ASICs, and SoCs by leveraging existing verification environments. Its advanced analysis helps security and verification teams identify and isolate security vulnerabilities before the device is manufactured saving costly design re-spins or catastrophic system failure due to an attack."],"links":["www.tortugalogic.com"],"contacts":[{"name":"Tortuga Logic, Inc.","email":"sales@tortugalogic.com","affiliation":""}]},{"category":"Information Leakage","vulnerability-attack":"Security Vulnerabilities due to Design/RTL Issues","solution-plugin":"Plug-in to existing Emulation/Prototyping hardware environments.","solution-status":"Prototyped as Software","licensing":"Annual License Fee","security-metric":"Information Leakage","security-metric-description":"Detects leakages that relate to confidentiality or integrity violations in the system","trl":"Not Available","description":["Radix-M provides SoC system level hardware security verification leveraging commercial emulators for firmware and hardware security validation. By running firmware and software on the SoC, Radix-M simultaneously analyzes the entire system, which greatly increases the detection and prevention of security vulnerabilities that may be lurking in the system\u2019s Root of Trust or processing system."],"links":["www.tortugalogic.com"],"contacts":[{"name":"Tortuga Logic, Inc.","email":"sales@tortugalogic.com","affiliation":""}],"affiliation":"Tortuga Logic, Inc."},{"category":"Information Leakage","vulnerability-attack":"Violations of hardware security requirements due to bugs in hardware or software ","solution-plugin":null,"solution-status":"Commercial","licensing":"Commercial License","security-metric":"Information Flow","security-metric-description":"Radix returns information flow analysis of the design as it relates to confidentiality or integrity violations in the system.","trl":"Not Available","description":["Radix employs patented information flow tracking technology to detect and prevent security vulnerabilities in FPGAs, ASICs and SoCs. The platform helps security and verification teams identify and isolate security vulnerabilities before the device is manufactured, saving costly design re-spins or catastrophic system failure due to an attack."],"links":["www.tortugalogic.com"],"contacts":[{"name":"Tortuga Logic, Inc.","email":"sales@tortugalogic.com","affiliation":""}],"affiliation":"Tortuga Logic, Inc."},{"category":"Information Leakage","vulnerability-attack":"Exhaustive verification of secure paths to critical hardware storage and resources","solution-plugin":"Questa Secure Check","solution-status":"Commercial or academic tool","licensing":"Commercial licensing","security-metric":null,"security-metric-description":null,"trl":"Not Available","description":["The Questa Secure Check app is a fully automated solution for exhaustively verifying that only the paths you specify can reach security or safety-critical storage elements \u2013 i.e. formally prove the sanctity of your DUTs \'root of trust.\'\xa0No knowledge of formal or property specification languages is required."],"links":["https://www.mentor.com/products/fv/questa-secure-check"],"contacts":[{"name":"Harry Foster","email":"harry_foster@mentor.com","affiliation":"Mentor, A Siemens Business"}],"affiliation":"Mentor, A Siemens Business"},{"category":"Information Leakage","vulnerability-attack":"Violation of information flow security policies due to design mistakes","solution-plugin":"Incorporate to conventional ASIC design flow to asses vulnerabilities due to violation of information flow policies at design stage","solution-status":"Commercial or academic tool","licensing":"Available upon request","security-metric":"Quantified uncertainty of information leakage","security-metric-description":"Evaluate probability of leakage during information propagation.","trl":"Not Available","description":["The tool is a compiler written which receives the denoted Verilog program and on which confidential checking is performed. In front-end, new hardware description language, extended from Verilog, is defined to denote asset. In back-end, a quantified information flow model is applied to evaluate threaten of information leakage. "],"links":["http://jin.ece.ufl.edu/"],"contacts":[{"name":"Xiaolong Guo","email":"guoxiaolong@ufl.edu","affiliation":"University of Florida"},{"name":"Yier Jin","email":"yier.jin@ece.ufl.edu","affiliation":"University of Florida"}],"affiliation":"University of Florida"},{"category":"Information Leakage","vulnerability-attack":"Secure information flow vulnerabilities, Access control violations, Data integrity and Leakage violations, Root of Trust violations","solution-plugin":"VC Formal\u2122 - Formal Security Verification (FSV) App","solution-status":"Commercial","licensing":"Commercial License","security-metric":"Formal Proof","security-metric-description":"Formal proofs for non-existence of data-integrity and leakage violations. Counter-examples for any violations.","trl":"Not Available","description":["VC Formal\u2122 is next-generation formal verification solution that has the capacity, speed and flexibility to verify some of the most complex SoC designs and includes comprehensive analysis and debug techniques to quickly identify root causes  leveraging Verdi\xae debug platform. The VC Formal solution consistently delivers highest performance and capacity, with more design bugs found, more proofs on larger designs and achieves faster coverage closure through the native integration with VCS\xae functional verification solution.","VC Formal FSV helps formally verify that secure data should not reach non-secure destinations and ensures data integrity, where non-secure data should not over-write (or reach) secure destinations.","- Industry leading deasign read capacity using VCS technology","- Novel secure blackboxing allows to scale to large designs","- Specialized security-aware solvers and orchestration helps improve runtime performance","- Advanced security-aware debugging capabilities using Verdi"],"links":["https://www.synopsys.com/verification/static-and-formal-verification/vc-formal.html"],"contacts":[{"name":"Synopsys, Inc.","email":"vcf_support@synopsys.com ","affiliation":""}],"affiliation":"Synopsys Inc."},{"category":"Hardware Trojan","vulnerability-attack":"Hardware Trojan Detection ","solution-plugin":"Detects violation of information flow security (IFS)  policies caused by Trojans","solution-status":"Prototyped as Software","licensing":"Academic License ","security-metric":"Malicious Observe/Control Point Identification, Trigger Condition Extraction","security-metric-description":null,"trl":"Not Available","description":["This Trojan detection framework is based on the observation that a Trojan, however, small, will alter the normal information flow of a design and thereby violate information flow security (IFS) policies. The tool detect violation of IFS policies due to Trojan. It can be applied to synthesized gatelevel netlist of a design to detect Trojan inserted by rogue 3PIP vendor or DFT vendor"],"links":["https://fics.institute.ufl.edu/"],"contacts":[{"name":"Mark Tehranipoor","email":"tehranipoor@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Domenic Forte","email":"dforte@ece.ufl.edu","affiliation":"University of Florida"}],"affiliation":"FICS Research, University of Florida"},{"category":"Hardware Trojan","vulnerability-attack":"Hardware Trojans","solution-plugin":"Statistical Test Gneration for Side Channel Analysis based Trojan Detection","solution-status":"Commercial or academic tool","licensing":"open source ","security-metric":"Side Channel Sensitivity","security-metric-description":null,"trl":"Not Available","description":["This tool, known as Multiple Excitation of Rare Switching (MERS), takes a Verilog netlist as input and generates efficient statistical tests to improve Trojan detection sensitivity based on side-channel analysis. "],"links":["https://www.cise.ufl.edu/research/esl/"],"contacts":[{"name":"Prabhat Mishra","email":"prabhat@ufl.edu","affiliation":"University of Florida"},{"name":"Swarup Bhunia","email":"swarup@ece.ufl.edu","affiliation":"University of Florida"}],"affiliation":"University of Florida"},{"category":"Probing","vulnerability-attack":"Micro-Probing Attack","solution-plugin":"Incorporate to conventional physical design flow","solution-status":"Commercial or academic tool","licensing":"Academic license","security-metric":"Exposed Area to Probing Attack","security-metric-description":"Detects vulnerable area on metal wires in the design\'s layout to probing attack","trl":"Not Available","description":["This tool scans the design\'s physical layout and find vulnerable exposed area of metal wires to probing attack. Based on the exposed area feedback, the layout of the chip could be redesigned to mitigate the threat from probing attack. "],"links":["https://fics.institute.ufl.edu/"],"contacts":[{"name":"Mark Tehranipoor","email":"tehranipoor@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Domenic Forte","email":"dforte@ece.ufl.edu","affiliation":"University of Florida"}],"affiliation":"FICS Research, University of Florida"},{"category":"Probing","vulnerability-attack":"Micro-Probing Attack","solution-plugin":"Incorporate to conventional physical design flow","solution-status":"Commercial or academic tool","licensing":"Academic license","security-metric":"Target Nets and Shield Nets Identification Metrics","security-metric-description":"Identifies security-critical target nets which could leak asset information and appropriate shield nets to provide coverage to target nets","trl":"Not Available","description":["The floor-planning and routing of the design are constrained so that sensitive target nets are protected by internal \u2018shield\u2019 nets with low overhead."],"links":["https://fics.institute.ufl.edu/"],"contacts":[{"name":"Mark Tehranipoor","email":"tehranipoor@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Domenic Forte","email":"dforte@ece.ufl.edu","affiliation":"University of Florida"}],"affiliation":"FICS Research, University of Florida"},{"category":"Fault Injection","vulnerability-attack":"Fault injection attack in finite state machine (FSM)","solution-plugin":"Quantitatively evaluates how susceptible a FSM is against fault injection attacks.","solution-status":"Commercial or academic tool","licensing":"Academic License ","security-metric":"Vulnerability factor of fault injection (VF_FI)","security-metric-description":null,"trl":"Not Available","description":["Our proposed AVFSM takes as input (i) gate-level netlist of the design; (ii) FSM synthesis report; and (iii) user given inputs. AVFSM then extracts the state transition graph of the FSM from the gate-level netlist and reports a quantitative measure of the vulnerability of FSM to fault injection attack."],"links":["https://github.com/bahmedraaz/AVFSM.git","https://fics.institute.ufl.edu/"],"contacts":[{"name":"Mark Tehranipoor","email":"tehranipoor@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Domenic Forte","email":"dforte@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Farimah Farahmandi","email":"farimah@ece.ufl.edu","affiliation":"University of Florida"}],"affiliation":"FICS Research, University of Florida"},{"category":"Fault Injection","vulnerability-attack":"Vulnerability measurement/fault injection attack","solution-plugin":"Z01X\u2122 - Validation by fault injection measurement","solution-status":"Commercial","licensing":"Commercial License","security-metric":"Vulnerability Measurement","security-metric-description":"Measurements of vulnerability to localized attacks, and possible attack detection by a safety mechanism","trl":"Not Available","description":["Z01X is a fault simulation tool which injects faults at specified design locations in RTL or netlist form and simulates the effects of the injected fault, comparing the faulty design behavior to that of the non-faulty design. Z01X was developed with Functional Safety in mind, helping users to measure the Diagnostic Coverage of safety mechanisms added to the design,  as recommended by Functional Safety Standards (ISO 26262, IEC 61508). Z01X is a concurrent fault simulator, allowing for many faults to be simulated within the same run.","The fault simulation capability is very useful in testing vulnerability of malicious fault injection attacks on security IPs, using the transient fault models. If a safety mechanisms exist in the design, Z01X can measure its ability to notice dangerous faults and sound an alarm when they occur. By nature, transient faults model requires many fault injections, both in design location and in various simulation times (e.g. every clock cycle), and hence the ability to simulate many faults in a fast, efficient manner is of outmost importance.","Some of Z01X useful capabilities: fault pruning by static analysis, testability analysis to find most suitable tests for faulty design stimulus etc."],"links":["https://www.synopsys.com/verification/simulation/z01x-functional-safety.html"],"contacts":[{"name":"Synopsys, Inc.","email":"Z01X_support@synopsys.com","affiliation":""}],"affiliation":"Synopsys Inc."},{"category":"Logic Locking","vulnerability-attack":"Weak Netlist Design","solution-plugin":"Stand alone binaries for Analyzing netlists","solution-status":"Prototyped as Software","licensing":"","security-metric":"Weak Netlist Sequential Encryption Breaking","security-metric-description":null,"trl":"Not Available","description":["Netlists that use logic locking with sequential keys are easy to detect and break by using a combination of Strongly Connected Component finding and SAT solving methods. We use these methods to find both trojans and keys for locking netlists."],"links":[],"contacts":[{"name":"Travis Meade","email":"travm12@knights.ucf.edu","affiliation":"University of Central Florida"}],"affiliation":"University of Central Florida"},{"category":"Logic Locking","vulnerability-attack":"IC Overproduction and Cloning","solution-plugin":"SAT-resistant Logic Locking","solution-status":"Algorithm","licensing":"","security-metric":"","security-metric-description":null,"trl":"Not Available","description":["Due to the prohibitive costs of semiconductor manufacturing, most computer chip design companies outsource their production to offshore foundries. As many of these chips may be manufactured in environments of limited trust, problems of the piracy of intellectual property (IP) and the overproduction of integrated circuits (ICs) have emerged in recent years. This project focuses on designing a secure logic locking technique to enable protection against untrusted IC manufacturing. The developed solution is resistant to all known attacks."],"links":["http://www.eng.auburn.edu/~uguin/publications.html","https://ieeexplore.ieee.org/document/8290974/","https://ieeexplore.ieee.org/abstract/document/7928946/"],"contacts":[{"name":"Ujjwal Guin","email":"ujjwal.guin@auburn.edu","affiliation":"Auburn University"}],"affiliation":"Auburn University"},{"category":"Side Channel Analysis","vulnerability-attack":"EM Side-Channel Attack","solution-plugin":"EM Side-Channel Attack Analyzer","solution-status":"Prototyped as Software","licensing":"The software is available upon request.","security-metric":"Measurements to Disclosure (MTD)","security-metric-description":"Id of cipher execution evaluations required to extract a secret key","trl":"Not Available","description":["EM Side-Channel Attack Analyzer gets the layout of a design of a cryptographic block and for a given EM probe computes MTD for different spatial locations and probe-to-die distances."],"links":["http://users.ece.utexas.edu/~michael/"],"contacts":[{"name":"Michael Orshansky","email":"orshansky@utexas.edu","affiliation":"University of Texas at Austin"},{"name":"Ali Yilmaz","email":"yilmaz@utexas.edu","affiliation":"University of Texas at Austin"}],"affiliation":"University of Texas at Austin"},{"category":"Side Channel Analysis","vulnerability-attack":"Power side-channel vulnerability of hardware designs","solution-plugin":"SCRIPT: Side-channel Vulnerability Assessment.  Incorporate to conventional ASIC design flow to asses power side-channel vulnerabilities at design stage using only a few patterns","solution-status":"Algorithm","licensing":"Academic License","security-metric":"Side-channel vulnerability (SCV) metric","security-metric-description":null,"trl":"Not Available","description":["SCRIPT starts by defining the underlying properties of the hardware implementation which\\nare exploited by side-channel attacks. It then utilizes information flow tracking to identify registers that exhibit those properties and, therefore, leak information through the side-channel. Central to\\nSCRIPT is the side-channel vulnerability (SCV) metric which is conceptually similar to the traditionally used signal-to-noise ratio (SNR) metric. However, instead of requiring thousands of traces from silicon measurements like SNR, SCRIPT utilizes formal verification techniques to generate SCV-guided patterns/plaintexts allowing us to derive SCV using only a few patterns (ideally as low as two) at gate-level. SCV can estimate PSCL vulnerability at pre-silicon stage by determining the id of plaintexts required to attain a specific SCA success rate."],"links":["https://fics.institute.ufl.edu/"],"contacts":[{"name":"Mark Tehranipoor","email":"tehranipoor@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Domenic Forte","email":"dforte@ece.ufl.edu","affiliation":"University of Florida"}],"affiliation":"FICS Research, University of Florida"},{"category":"Side Channel Analysis","vulnerability-attack":"RTL-PSC: Power Side-Channel Leakage Assessment at Register-Transfer Level","solution-plugin":"Incorporate to conventional ASIC design flow for power side-channel leakage assessment at register-transfer level","solution-status":"Algorithm","licensing":"Academic License","security-metric":"Side-channel vulnerability evaluation metrics & Side-channel vulnerability validation metric","security-metric-description":null,"trl":"Not Available","description":["An automatic evaluation framework, called RTL-PSC, is proposed for side-channel leakage assessment of a cryptographic hardware at the RTL with built-in evaluation metrics. Furthermore, in order to ensure and demonstrate the leakage assessment accuracy at the RTL, a validation metric is proposed to validate RTL vulnerability through both gate-level and silicon results."],"links":["https://fics.institute.ufl.edu/"],"contacts":[{"name":"Mark Tehranipoor","email":"tehranipoor@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Domenic Forte","email":"dforte@ece.ufl.edu","affiliation":"University of Florida"}],"affiliation":"FICS Research, University of Florida"},{"category":"Logic Locking","vulnerability-attack":"Tampering attack on logic locking, and crypto primitives","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"N/A","security-metric-description":null,"trl":"2","description":["The attack consists in designing hardware Trojans that can evade manufacturing test patterns (i.e. stuck-at fault, delay fault, etc.) to extract key information from logic locked circuits and cryptographic circuits. The inputs to the proposed tool include (i) key-dependent locked netlist, (ii) test pattern set, and (iii) trojan type. It selects the trigger inputs from the original netlist that are not dependent on the key value. Using these trigger inputs, it reports the Trojan activation pattern which does not belong to the test patterns set, after performing logic simulation for the test pattern set. "],"links":["https://ieeexplore.ieee.org/abstract/document/8368626","https://arxiv.org/abs/1909.07426"],"contacts":[{"name":"Ujjwal Guin","email":"ujjwal.guin@auburn.edu","affiliation":"Auburn University"},{"name":"Ayush Jain","email":"ayush.jain@auburn.edu","affiliation":"Auburn University"}],"affiliation":"Auburn University"},{"category":"Functional Safety","vulnerability-attack":"Functional Safety Verification tool for Systolic Array-based Deep Learning Hardware Accelerators","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"FuSa Verification and Validation","security-metric-description":null,"trl":"3","description":["Faults manifested in the datapath of a systolic array due to latent manufacturing defects or single event effects may lead to Functional Safety (FuSa) violation in DNN accelerators, ending in a catastrophe. Hence, to ensure FuSa, this tool employs efficient algorithms to obtain a diminutive set of functional test patterns, which when executed on the accelerator detects the presence of faults, if any, directly at run-time during in-field inference execution. "],"links":["https://personal.utdallas.edu/~kanad.basu/"],"contacts":[{"name":"Shamik Kundu","email":"","affiliation":"University of Texas at Dallas"},{"name":"Suvadeep Banerjee","email":"","affiliation":"Intel Corporation"},{"name":"Arnab Raha","email":"","affiliation":"Intel Corporation"},{"name":"Suriyaprakash Natarajan","email":"","affiliation":"Intel Corporation"},{"name":"Kanad Basu","email":"kanad.basu@utdallas.edu","affiliation":"University of Texas at Dallas"}],"affiliation":"Intel Corporation and University of Texas at Dallas"},{"category":"Reverse Engineering","vulnerability-attack":"Histogram-based Auto Segmentation for Reverse Engineering on SEM images","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"N/A","security-metric-description":null,"trl":"2","description":["This tool assists in the automated segmentation of SEM images based on pixel intensity values. The number of materials in the images can also be identified as well. A good quality segmentation of structures in the SEM image is required for converting the raw SEM image into a layout image for assisting in various Reverse Engineering and Hardware Assurance applications.   "],"links":[""],"contacts":[{"name":"Ronald Wilson","email":"ronaldwilson@ufl.edu","affiliation":"University of Florida"},{"name":"Domenic Forte","email":"dforte@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Navid Asadizanjani","email":"nasadi@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Damon Woodard","email":"dwoodard@ece.ufl.edu","affiliation":"University of Florida"}],"affiliation":"FICS Research, University of Florida"},{"category":"Reverse Engineering","vulnerability-attack":"Large-scale Accelerated Segmentation for Reverse Engineering on SEM images","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"N/A","security-metric-description":null,"trl":"2","description":["This tool assists in the automated segmentation of SEM images based on spectral filtering. This approach utilizes noisy fast-acquired images and parallel processing to provide fast and good quality segmentation for SEM images. A good quality segmentation of structures in the SEM image is required for converting the raw SEM image into a layout image for assisting in various Reverse Engineering and Hardware Assurance applications.  "],"links":[""],"contacts":[{"name":"Ronald Wilson","email":"ronaldwilson@ufl.edu","affiliation":"University of Florida"},{"name":"Domenic Forte","email":"dforte@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Navid Asadizanjani","email":"nasadi@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Damon Woodard","email":"dwoodard@ece.ufl.edu","affiliation":"University of Florida"}],"affiliation":"FICS Research, University of Florida"},{"category":"Hardware Trojan","vulnerability-attack":"AutoMag: Automated SEM imaging parameter fine-tuning for content-aware accelerated imaging","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"N/A","security-metric-description":null,"trl":"2","description":["This tool assists in the image acquisition phase in the SEM device. The tool analyzes the density of features and their relative dimensions to determine a good image acquisition setting for the SEM. The dynamic update of imaging parameters can save on imaging time budget by increasing or decreasing field-of-view based on feature density and dimensions.   "],"links":[""],"contacts":[{"name":"Ronald Wilson","email":"ronaldwilson@ufl.edu","affiliation":"University of Florida"},{"name":"Domenic Forte","email":"dforte@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Navid Asadizanjani","email":"nasadi@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Damon Woodard","email":"dwoodard@ece.ufl.edu","affiliation":"University of Florida"}],"affiliation":"FICS Research, University of Florida"},{"category":"Hardware Trojan","vulnerability-attack":"Automated Standard Cell Library Extractor on SEM images for IC Reverse Engineering","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"N/A","security-metric-description":null,"trl":"2","description":["This tool assists in the automatic population of standard cell library from SEM images of the contact layer in ICs. Both low-voltage surface imaging and high-voltage non-invasive penetrative imaging can be used in this tool. The functionality of the extracted standard cells are manually decoded by an expert. Knowledge of the standard cell library is a critical requirement in Reverse Engineering and several Hardware Assurance applications."],"links":[""],"contacts":[{"name":"Ronald Wilson","email":"ronaldwilson@ufl.edu","affiliation":"University of Florida"},{"name":"Domenic Forte","email":"dforte@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Navid Asadizanjani","email":"nasadi@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Damon Woodard","email":"dwoodard@ece.ufl.edu","affiliation":"University of Florida"}],"affiliation":"FICS Research, University of Florida"},{"category":"Hardware Trojan","vulnerability-attack":"Multi-circuits localization for hardware assurance","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Target circuits detection and time complexity","security-metric-description":null,"trl":"3","description":["The tool aims to automatically and efficiently locate the image area that contains circuits under analysis from a large-scale layout image. It utilizes design information and incorporates machine learning and string search algorithms to detect multi-target circuits. This tool can be applied to synthetic or real images of gate-level netlist."],"links":[""],"contacts":[{"name":"Hangwei Lu","email":"qslvhw@ufl.edu"},{"name":"Ronald Wilson","email":"ronaldwilson@ufl.edu","affiliation":"University of Florida"},{"name":"Nidish Vashistha","email":"nidish@ufl.edu","affiliation":"University of Florida"},{"name":"Navid Asadizanjani","email":"nasadi@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Mark Tehranipoor","email":"tehranipoor@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Damon Woodard","email":"dwoodard@ece.ufl.edu","affiliation":"University of Florida"}],"affiliation":"University of Florida"},{"category":"Hardware Trojan","vulnerability-attack":"Mixed Signal Controllability and Observability Analysis Tool (MS-COAT)","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Hardware trojan detection (Analog and Digital) and Test coverage analysis (Analog and Digital)","security-metric-description":null,"trl":"3","description":["Controllability and observability analysis have proven useful in detecting hardware trojans. However, these analyses can only be performed on digital signals. MS-COAT is a stand-alone application with an easy to use GUI that expands controllability and observability analysis into the analog and mixed signal domain. The tool takes in simulation waveforms, and outputs controllability and observability results in the form of an html report. The tool uses this information to extract a list of nodes which are vulnerable to trojan insertion. "],"links":[""],"contacts":[{"name":"Nima Maghari","email":"maghari@ece.ufl.edu","affiliation":"University of Florida"}],"affiliation":"University of Florida"},{"category":"Side Channel Analysis","vulnerability-attack":"Side-channel Leakage Identification via Correlation Extraction (SLICE)","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Risk and Vulnerability Assessment and Hardware trojan detection (Analog and Digital)","security-metric-description":null,"trl":"3","description":["SLICE is a stand-alone application that informs designers about the side-channel leakage vulnerability of the design in question. The tool takes in simulation waveforms, and allows user to define important signals which should remain hidden. SLICE intelligently finds side channel nodes and investigates the amount of leakage present. The tool then generates an HTML report with a list of all nodes that exceed a user defined leakage threshold."],"links":[""],"contacts":[{"name":"Nima Maghari","email":"maghari@ece.ufl.edu","affiliation":"University of Florida"}],"affiliation":"University of Florida"},{"category":"Hardware Trojan","vulnerability-attack":"Automated Test Vector Generation Utility (ATV-GU)","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Automated PCB assurance testing and verification and automated trojan detection","security-metric-description":null,"trl":"2","description":["ATV-GU is a tool that streamlines the process of writing the thousands of JTAG test patterns that are often needed to  ensure PCBs against hardware trojans. ATV-GU takes in a list of desired test patterns, a circuit netlist, and JTAG setup information (BSDL files). The user is able to define the number of clock cycles each pattern is evaluated for. The Tool outputs an SVF file which is compatible with most Automated Test Environment (ATE) hardware. The SVF file can be used to run the test pattern."],"links":[""],"contacts":[{"name":"Nima Maghari","email":"maghari@ece.ufl.edu","affiliation":"University of Florida"}],"affiliation":"University of Florida"},{"category":"Information Leakage","vulnerability-attack":"ADEC RF Signature Correlation with IC Design Data to Mitigate Information Leakage","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Generation of Design Rules to Mitigate RF Leakage and Verification of Integrity","security-metric-description":null,"trl":"3","description":["The use of RF signatures using the Advanced Diagnostics of Electronic Components (ADEC) tool correlated with CAD design data to mitigate information leakage."],"links":["http://www.nokomisinc.com/"],"contacts":[{"name":"Walter Keller","email":"wkeller@nokomisinc.com","affiliation":"Nokomis Inc."},{"name":"Vladimir Makarenko","email":"","affiliation":"Nokomis Inc."},{"name":"Matthew Moynihan","email":"","affiliation":"Nokomis Inc."}],"affiliation":"Nokomis Inc."},{"category":"Hardware Trojan","vulnerability-attack":"An Improved Automatic Hardware Trojan Generation Platform","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Enhance the diversity of hardware Trojan samples used for machine learning-based detection","security-metric-description":null,"trl":"1","description":["The number of HT-infected circuits available in current public HT benchmarks is somewhat limited and the circuits lack diversity in structure. The subsequent effect on detection results is overfitting, especially for machine learning (ML)-based detection techniques. Therefore, this research presents an improved automatic HT generation platform for the generation of HT-infected circuits. The generation platform is highly configurable in terms of the HT trigger condition, trigger type, payload type and in the number and variety of HT-infected circuits that can be generated. In this research, the transition probability of netlists is employed to obtain the netlist activity of a chip design for use in determining the appropriate position for HT insertion."],"links":[""],"contacts":[{"name":"Shichao Yu","email":"syu08@qub.ac.uk","affiliation":"Queen\u2019s University Belfast"},{"name":"Chongyan Gu","email":"","affiliation":"Queen\u2019s University Belfast"},{"name":"Weiqiang Liu","email":"","affiliation":"Nanjing University of Aeronautics and Astronautics"},{"name":"M\xe1ire O\u2019Neill","email":"m.oneill@ecit.qub.ac.uk","affiliation":"Queen\u2019s University Belfast"}],"affiliation":"Centre for Secure Information Technologies, ECIT, Queen\u2019s University Belfast, Belfast, UK and College of EIE, Nanjing University of Aeronautics and Astronautics, Nanjing, China"},{"category":"Hardware Trojan","vulnerability-attack":"A Novel Feature Extraction Strategy for Hardware Trojan Detection","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Extract features for hardware Trojan detection on gate-level netlist","security-metric-description":null,"trl":"1","description":["Recently, machine learning (ML) approaches are being considered for HT detection. However, to efficiently extract HT features from complex IC designs and utilize common ML-based detection approaches is challenging. In this research, a novel HT feature extraction strategy based on netlist topology is proposed to tackle the challenges. The HT features are extracted from the circuit topology rather than statistical analysis in previous research. A commonly utilized support vector machine (SVM)-based HT detection model is employed for data training and testing using the extracted features on HT benchmarks from both open-sourced library and HT generation platform to prove the feasibility and efficiency of the proposed HT feature extraction strategy. "],"links":[""],"contacts":[{"name":"Shichao Yu","email":"syu08@qub.ac.uk","affiliation":"Queen\u2019s University Belfast"},{"name":"Chongyan Gu","email":"","affiliation":"Queen\u2019s University Belfast"},{"name":"Weiqiang Liu","email":"","affiliation":"Nanjing University of Aeronautics and Astronautics"},{"name":"M\xe1ire O\u2019Neill","email":"m.oneill@ecit.qub.ac.uk","affiliation":"Queen\u2019s University Belfast"}],"affiliation":"Centre for Secure Information Technologies, ECIT, Queen\u2019s University Belfast, Belfast, UK and College of EIE, Nanjing University of Aeronautics and Astronautics, Nanjing, China"},{"category":"Side Channel Analysis","vulnerability-attack":"RedHawk-SC Security","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"T-score and SMTD","security-metric-description":null,"trl":"3","description":["Ansys RedHawk-SC Security is a pre-silicon multi-physics security verification solution to assessing side-channel leakage of crypto IPs and SoC. It leverages the established industry-golden chip-package-system sign-off methodology, the SeaScape elastic compute infrastructure and foundry-certified silicon model to enable side-channel analytics on system power-noise, electromagnetic and thermal emissions.  "],"links":[""],"contacts":[{"name":"Norman Chang","email":"","affiliation":"Ansys Inc."},{"name":"Lang Lin","email":"lang.lin@ansys.com","affiliation":"Ansys Inc."},{"name":"Dinesh Selvakumaran","email":"","affiliation":"Ansys Inc."}],"affiliation":"Ansys Inc."},{"category":"Fault Injection","vulnerability-attack":"Fault Detection of Multiplication in Galois Fields","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Fault analysis attacks countermeasures","security-metric-description":null,"trl":"1","description":["This RTL solution, which is being developed, provides countermeasures for attacks based on active side-channels targeting fault resiliency"],"links":[""],"contacts":[{"name":"Alvaro Cintas Canto","email":"","affiliation":"University of South Florida"},{"name":"Mehran Mozaffari Kermani","email":"mehran2@usf.edu","affiliation":"University of South Florida"}],"affiliation":"University of South Florida"},{"category":"Malware","vulnerability-attack":"Defense against adversarial attacks in Hardware-based Malware detectors","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Malware detection","security-metric-description":null,"trl":"3","description":["Recently, adversarial attacks have been designed by introducing perturbations in the HPC traces used in hardware-based Malware detectors, thereby misclassifying an application. This tool provides a defense mechanism against this adversarial attack by designing multiple ML classifiers trained on different sets of HPCs.  The tool randomly selects a classifier; thus, confusing the attacker about the HPCs or the number of classifiers applied. The tool improves the detection accuracy, for a near perfect (99.4%) restoration of the original accuracy of the HMD."],"links":["https://personal.utdallas.edu/~kanad.basu/"],"contacts":[{"name":"Abraham Peedikayil Kuruvila","email":"","affiliation":"University of Texas at Dallas"},{"name":"Shamik Kundu","email":"","affiliation":"University of Texas at Dallas"},{"name":"Kanad Basu","email":"kanad.basu@utdallas.edu","affiliation":"University of Texas at Dallas"}],"affiliation":"University of Texas at Dallas"},{"category":"Information Leakage","vulnerability-attack":"Concolic Testing on RTL for Detecting Security Vulnerabilities","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Security vulnerability detection","security-metric-description":null,"trl":"3","description":["This tool is enabled with a Register Transfer Level (RTL) security vulnerability detection algorithm, that extracts critical process flows from a RTL design and executes RTL-level concolic testing to generate security test cases for identifying critical exploits manifested in a System-on-Chip (SoC). The tool is evaluated on open source RISC-V-based SoCs. The tool is successful in detecting the security vulnerabilities manifested in the processor core as well as in the rest of the SoC, e.g., debug modules, peripherals, etc., thereby providing a comprehensive vulnerability check on the entire hardware design."],"links":["https://personal.utdallas.edu/~kanad.basu/"],"contacts":[{"name":"Abraham Peedikayil Kuruvila","email":"","affiliation":"University of Texas at Dallas"},{"name":"Shamik Kundu","email":"","affiliation":"University of Texas at Dallas"},{"name":"Kanad Basu","email":"kanad.basu@utdallas.edu","affiliation":"University of Texas at Dallas"}],"affiliation":"University of Texas at Dallas"},{"category":"Information Leakage","vulnerability-attack":"COPPTCHA: COPPA Tracking by Checking Hardware-Level Activity","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Security verification and privacy","security-metric-description":null,"trl":"3","description":["Mobile applications handled by children need to adhere to COPPA regulations. The applications should not transmit or collect personal data from the user. However, frequently, these apps violate COPPA regulations. This tool, COPPTCHA, uses  hardware performance counters to check the COPPA compliance of mobile apps. The COPPTCHA system can alert the user when it sees non-COPPA-compliant apps. COPPTCHA can also perform specialized detection of Personal Identifiable Information when the apps transmit sensitive features Android ID, Advertising ID, Device Description and location."],"links":["https://personal.utdallas.edu/~kanad.basu/"],"contacts":[{"name":"Kanad Basu","email":"kanad.basu@utdallas.edu","affiliation":"University of Texas at Dallas"},{"name":"Suha. S. Hussain","email":"","affiliation":"Georgia Institute of Technology"},{"name":"Ujjwal Gupta","email":"","affiliation":"Intel Corporation"},{"name":"Ramesh Karri","email":"","affiliation":"New York University"}],"affiliation":"University of Texas at Dallas, Georgia Institute of Technology, Intel Corporation and New York University"},{"category":"Information Leakage","vulnerability-attack":"Runtime Hardware Security Verification Using Approximate Computing","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Online integrity verification of third-party IP cores","security-metric-description":null,"trl":"1","description":["The proposed security solution employs spatial and temporal approximate computing to detect integrity attacks resulting from untrusted third-party IP cores at runtime. It is deployed in the trusted CPU component that is separate from the untrusted FPGA component in a heterogeneous CPU-FPGA system-on-chip (SoC). Since the integrity attacks typically compromise the results of the IP cores dramatically, they can be effectively and efficiently captured by an inaccurate but fast approximate execution."],"links":["www.ece.rutgers.edu/~sw891"],"contacts":[{"name":"Mengmei Ye","email":"","affiliation":"Rutgers University"},{"name":"Xianglong Feng","email":"","affiliation":"Rutgers University"},{"name":"Sheng Wei","email":"sheng.wei@rutgers.edu","affiliation":"Rutgers University"}],"affiliation":"Rutgers University"},{"category":"Logic Locking","vulnerability-attack":"Logic Obfuscation Through Enhanced Threshold Voltage Defined Logic Family","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Protection of IPs/ICs from reverse engineering ","security-metric-description":null,"trl":"3","description":["This IP features a logic family where the physical appearance is identical for different functionalities by leveraging the different threshold voltage devices provided in any standard CMOS technology. As identical schematic and layout is used for different functionalities, it is extremely difficult to discern the purpose of the schematic from imaging and de-layering and thus provides protection against reverse engineering."],"links":[""],"contacts":[{"name":"Nima Maghari","email":"maghari@ece.ufl.edu","affiliation":"University of Florida"}],"affiliation":"University of Florida"},{"category":"Logic Locking","vulnerability-attack":"Logic Locking/Obfuscation Key Insertion Tool (KIT)","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Corruptibility, attack resiliency, hamming distance, key interaction metric","security-metric-description":null,"trl":"1","description":["Key Insertion Tool (KIT) is an automated hardware obfuscation tool. It can perform hardware obfuscation in mapped gate-level netlist designs. It inserts user-specified number of obfuscating XOR/XNOR key gates, randomly coupled with NOT gates, in design. Placement of key gates can either be following published methodologies (Random, SLL, largest logic cone), or user specified. The tool can recognize several standard libraries (SAED, Cadence) that is used to map the netlist and inserts new gates accordingly. Such obfuscated designs can readily be used in commercial tools. It also supports technology independent netlist format. Additionally, it includes simple testbench and visualization features."],"links":[""],"contacts":[{"name":"Sarah Amir","email":"sarah.amir@ufl.edu","affiliation":"University of Florida"},{"name":"Domenic Forte","email":"dforte@ece.ufl.edu","affiliation":"University of Florida"}],"affiliation":"University of Florida"},{"category":"Logic Locking","vulnerability-attack":"Synthetic HW Security Benchmark Generator","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Divergence, adaptability, attack resiliency","security-metric-description":null,"trl":"1","description":["This is a framework that generates synthetic benchmarks optimized to have maximum variation from the reference benchmarks. It utilizes linear optimization to generate an endless number of synthetic combinational benchmarks that are adaptable to user input constraints and divergent in quantifiable structural features from input reference benchmarks. This framework offers customization for generating richer and more challenging benchmarks for data-driven hardware security. The optimization tool, developed for MATLAB, requires benchmarks to deviate from, and user inputs for size, input, output and delay. A generation tool is accompanied that can translate the stat file into gate level verilog netlist. "],"links":[""],"contacts":[{"name":"Sarah Amir","email":"sarah.amir@ufl.edu","affiliation":"University of Florida"},{"name":"Domenic Forte","email":"dforte@ece.ufl.edu","affiliation":"University of Florida"}],"affiliation":"University of Florida"},{"category":"Fault Injection","vulnerability-attack":"PATRON (PrAgmaTic appROach for eNcoding LFI resistant FSMs )","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Vulnerability Metric (VM(x)) - The percentage of states where x laser faults can lead to a sensitive state.","security-metric-description":null,"trl":"2","description":["Finite State Machines (FSMs) control the overall functionality in majority of the digital systems. By FSM fault injection, an adversary can attain unauthorized entry to sensitive states ensuing information leakage and privilege escalation. Laser fault injection (LFI) enables precise altering of individual flip-flops. To counter this, we have developed an FSM state encoding tool (PATRON) that utilizes don\u2019t-care states to increase the number of lasers required to cause transitions into sensitive/protected states. PATRON outperforms conventional encoding and error correction based approaches with respect to both security and scalability for popular benchmarks. Additionally, the tool incorporates a vulnerability metric manifesting FSM design susceptibility."],"links":[""],"contacts":[{"name":"Muhtadi Choudhury","email":"muhtadichoudhury@ufl.edu","affiliation":"University of Florida"},{"name":"Shahin Tajik","email":"stajik@wpi.edu","affiliation":"Worcester Polytechnic Institute"},{"name":"Domenic Forte","email":"dforte@ece.ufl.edu","affiliation":"University of Florida"}],"affiliation":"University of Florida and Worcester Polytechnic Institute"},{"category":"PCB Assurance","vulnerability-attack":"Automated Unsupervised Alignment of X-Ray Tomography Imaged PCBs","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"N/A","security-metric-description":null,"trl":"3","description":["This tool utilizes linear regression to iteratively align an unprocessed 3-dimensional stack of an X-Ray CT imaged PCB to maximize the amount of information present for each 2-dimensional slice in the stack. There is no user intervention needed and the process is done completely unsupervised."],"links":[""],"contacts":[{"name":"Ulbert J. Botero","email":"jbot2016@ufl.edu","affiliation":"University of Florida"},{"name":"Navid Asadizanjani","email":"nasadi@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Damon Woodard","email":"dwoodard@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Domenic Forte","email":"dforte@ece.ufl.edu","affiliation":"University of Florida"}],"affiliation":"University of Florida"},{"category":"PCB Assurance","vulnerability-attack":"Automated Unsupervised Slice to Layer Identification of X-Ray Tomography Imaged PCBs","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"N/A","security-metric-description":null,"trl":"3","description":["Our tool takes an aligned volumetric stack of X-Ray CT imaged PCB slices and identifies what slices belong to what layer in the physical board. This technique utilizes clustering and location information of slices in the volumetric stack to predict a slice\u2019s respective layer and produces a layout image for each layer. No prior information or user intervention is needed or utilized to complete this process.  "],"links":[""],"contacts":[{"name":"Ulbert J. Botero","email":"jbot2016@ufl.edu","affiliation":"University of Florida"},{"name":"Navid Asadizanjani","email":"nasadi@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Damon Woodard","email":"dwoodard@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Domenic Forte","email":"dforte@ece.ufl.edu","affiliation":"University of Florida"}],"affiliation":"University of Florida"},{"category":"PCB Assurance","vulnerability-attack":"Automated Semi-Supervised Slice to Layer Identification of X-Ray Tomography Imaged PCBs","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"N/A","security-metric-description":null,"trl":"3","description":["This tool builds off of our unsupervised slice to layer identification tool to refine those results if the user has additional design information available. This design information can be in the form of PCB CAD layer digital images or previously X-rayed layer images to serve as a reference for the refinement of the slice to layer correspondence. No user intervention is necessary."],"links":[""],"contacts":[{"name":"Ulbert J. Botero","email":"jbot2016@ufl.edu","affiliation":"University of Florida"},{"name":"Navid Asadizanjani","email":"nasadi@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Damon Woodard","email":"dwoodard@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Domenic Forte","email":"dforte@ece.ufl.edu","affiliation":"University of Florida"}],"affiliation":"University of Florida"},{"category":"PCB Assurance","vulnerability-attack":"Automated Via Detection for PCB Reverse Engineering","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"N/A","security-metric-description":null,"trl":"3","description":["This tool utilizes slice to layer assignment in combination with hough circle transform, domain knowledge of PCB design/X-Ray CT imaging, and iteration to detect and localize vias in a multi-layered X-Ray CT imaged PCB. The user may determine the number of size tiers one wants to use if more or less than our recommended small, medium, and large tiers is desired for candidate via detection and evaluation. Additionally, users may provide radii ranges for particular sizes if known a priori to further enhance the algorithm but this is not necessary. Otherwise no human intervention is necessary. "],"links":[""],"contacts":[{"name":"Ulbert J. Botero","email":"jbot2016@ufl.edu","affiliation":"University of Florida"},{"name":"Navid Asadizanjani","email":"nasadi@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Damon Woodard","email":"dwoodard@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Domenic Forte","email":"dforte@ece.ufl.edu","affiliation":"University of Florida"}],"affiliation":"University of Florida"},{"category":"PCB Assurance","vulnerability-attack":"Automated Trace Extraction and Vectorization for PCB Reverse Engineering","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"N/A","security-metric-description":null,"trl":"2","description":["This tool utilizes a layer image of an X-Ray CT imaged PCB and produces the vertices necessary to extract the individual traces of the PCB layer. These trace vertices can be used for easy design compression, evaluation, and vectorization. As well as in combination with detected vias from our other tool to evaluate connectivity. No user intervention is necessary. "],"links":[""],"contacts":[{"name":"Ulbert J. Botero","email":"jbot2016@ufl.edu","affiliation":"University of Florida"},{"name":"Damon Woodard","email":"dwoodard@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Domenic Forte","email":"dforte@ece.ufl.edu","affiliation":"University of Florida"}],"affiliation":"University of Florida"},{"category":"Information Leakage","vulnerability-attack":"Security Vulnerability Assessment and Asset Protection Against Optical Attacks","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Target net/cell identification: Identify the nets or cells vulnerable to chip backside attacks, e.g. optical probing, photon emission, laser-fault injection. Differentiability: A metric based on the capabilities of the instruments used for chip activity monitoring during chip backside attacks. Information leakage: A metric based on the observability/accessibility to chip/asset signal activity.","security-metric-description":null,"trl":"3","description":["The tool evaluates an RTL netlist and employs information leakage identification approach to identify vulnerable logic cells involved in asset signal flow in FPAG, ASICs, and SoCs. The tool integrates appropriate masking approach into the design to camouflage the vulnerable cell/circuit activity. The tool modifies the physical layout of the design in automated fashion to achieve the security constrain and resource overhead defined by the OCM/designer."],"links":["https://fics.institute.ufl.edu/"],"contacts":[{"name":"Navid Asadizanjani","email":"nasadi@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Mark Tehranipoor","email":"tehranipoor@ece.ufl.edu","affiliation":"University of Florida"}],"affiliation":"University of Florida"},{"category":"PCB Assurance","vulnerability-attack":"Auto-3D: Automated Reverse Engineering of Printed Circuit Board Design","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Automated Netlist extraction for PCB, enabling Golden design verification and reverse engineering to create manufacturing documents.","security-metric-description":null,"trl":"2","description":["The verification of PCB design for failure analysis, proving evidence of IP theft by a competitor, and reverse engineering for product development or resurgence is a complex process requiring tools and experienced personnel. This process often requires time consuming destructive or expensive nondestructive tools for design derivation. X-ray volumetric analysis is used to collect 3D volume information from a PCB, and the Auto-3D system is capable of assisted and automated PCB netlist extraction. Auto-3D is developed upon open-source software capable of working with any X-ray tool equipped with adequate resolution and volumetric data collection."],"links":["https://gitlab.com/ficsresearch/xrayrecon/-/tree/master/xrayrecon"],"contacts":[{"name":"Navid Asadizanjani","email":"nasadi@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Mark Tehranipoor","email":"tehranipoor@ece.ufl.edu","affiliation":"University of Florida"},{"name":"John True","email":"jtrue15@ufl.edu","affiliation":"University of Florida"},{"name":"Dhwani Mehta","email":"dhwanimehta@ufl.edu","affiliation":"University of Florida"}],"affiliation":"University of Florida"},{"category":"FPGA Security","vulnerability-attack":"Secure Remote FPGA Initialization in an Untrusted Environment","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"N/A","security-metric-description":null,"trl":"3","description":["Develop a tool using the Secure Remote FPGA Initialization (SeRFI) protocol to transmit the encryption key securely from a trusted system designer into an FPGA in physical possession of an untrusted system assembler."],"links":[""],"contacts":[{"name":"Shang Shi","email":"shang.shi@ufl.edu","affiliation":"University of Florida"},{"name":"Tao Zhang","email":"tao.zhang@ufl.edu","affiliation":"University of Florida"}],"affiliation":"University of Florida"},{"category":"FPGA Security","vulnerability-attack":"BitFREE: On FPGA netlist recovery and trust verification","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"REA (Reversing Accuracy) evaluates the correctness of the netlist recovered from FPGA bitstream.","security-metric-description":null,"trl":"7","description":["The tool recovers readable netlist from binary FPGA bitstream of arbitrary covered FPGA model. The recovered netlist serves as the testbed for existing well-developed pre-silicon Trojan techniques to detect whether any malicious logics hidden in the FPGA design. The tool works at both bitstream and netlist levels."],"links":["https://fics.institute.ufl.edu/"],"contacts":[{"name":"Tao Zhang","email":"tao.zhang@ufl.edu","affiliation":"University of Florida"},{"name":"Farimah Farahmandi","email":"farimah@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Mark Tehranipoor","email":"tehranipoor@ece.ufl.edu","affiliation":"University of Florida"}],"affiliation":"University of Florida"},{"category":"Information Leakage","vulnerability-attack":"Automated Mapping of Security Properties from C to Gate Level","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"N/A","security-metric-description":null,"trl":"3","description":["This tool automatically maps security properties from one abstraction level of the design to another. To be specific, it can map security properties starting from the C-level to the Gate-level. It also identifies new vulnerabilities introduced during the design transition and extends or expands the security properties to verify the security equivalence between the design abstraction levels."],"links":["https://fics.institute.ufl.edu/"],"contacts":[{"name":"Farimah Farahmandi","email":"farimah@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Mark Tehranipoor","email":"tehranipoor@ece.ufl.edu","affiliation":"University of Florida"}],"affiliation":"University of Florida"},{"category":"Information Leakage","vulnerability-attack":"Security Modeling Specification and Security Estimation Technology","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"N/A","security-metric-description":null,"trl":"1","description":["This tool is used to estimate the security score in a system-on-chip (SOC) for four threats: side-channel analysis, reverse engineering, supply-chain, and malicious hardware. It takes individual IP\'s security score as input and estimates the overall security score in SOC-level. It analyzes the SOC integration and identifies different parameters and their effect on the IP-level security score. It then builds a security model for each threat by quantifying the effect of different parameters. The accuracy of the security estimation depends heavily on the security model."],"links":["https://fics.institute.ufl.edu/"],"contacts":[{"name":"Mark Tehranipoor","email":"tehranipoor@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Fahim Rahman","email":"fahimrahman@ece.ufl.edu","affiliation":"University of Florida"}],"affiliation":"University of Florida"},{"category":"Information Leakage","vulnerability-attack":"Identification of security assets of an SoC","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Confidentiality verification (asset leakage)","security-metric-description":null,"trl":"2","description":["The tool intends to identify design components at the fan out of a security asset that supports security assets to propagate and requires protection for comprehensive security assurance. Using information leakage, power side channel, and fault injection vulnerability analysis, the tool assesses asset carrying design components\' vulnerability and identifies the most vulnerable ones as secondary assets."],"links":[""],"contacts":[{"name":"Nusrat Farzana Dipu","email":"ndipu@ufl.edu","affiliation":"University of Florida"},{"name":"Avinash Ayalasomayajula","email":"ayalasomayajul.a@ufl.edu","affiliation":"University of Florida"},{"name":"Mark Tehranipoor","email":"tehranipoor@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Farimah Farahmandi","email":"","affiliation":"University of Florida"},{"name":"Fahim Rahman","email":"","affiliation":"University of Florida"}],"affiliation":"University of Florida"},{"category":"Side Channel","vulnerability-attack":"RTL-PSC: RTL-simulation based Power Side-Channel Analysis","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Confidentiality verification against power-side channel leakage","security-metric-description":null,"trl":"6","description":["RTL-PSC tool can be used to access the power side-channel leakage vulnerabilities in the RTL design. It assists to identify if the functional implementation of the design is leaking power side-channel information. It also helps to identify which modules in the implementation are leaking the most information, so that functional countermeasures could be applied to those modules."],"links":["https://fics.institute.ufl.edu/"],"contacts":[{"name":"Mark Tehranipoor","email":"tehranipoor@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Farimah Farahmandi","email":"farimah@ece.ufl.edu","affiliation":"University of Florida"}],"affiliation":"University of Florida"},{"category":"Side Channel","vulnerability-attack":"RTL-PSC TG: RTL power side-channel assessment framework using formal verification-based test generation","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"SCV (side-channel vulnerability) evaluates power side-channel leakage at RTL","security-metric-description":null,"trl":"7","description":["RTL-PSC TG utilizes RTL information flow tracking (IFT) techniques to track down the sensitive variables which would serve as the interest of adversaries during post-silicon DPA/CPA. Then the assertions based on associated HW/HD model are composed for those variables and experience the proof by formal verification tool. Test patterns corresponding to different HW/HD values will be derived as the counterexamples to the assertions. Next, the deduced patterns are applied on the RTL implementation during simulation to retrieve the SAIF file for RTL power estimation, calculating SCV metrics and reflecting the side-channel vulnerabilities."],"links":["https://fics.institute.ufl.edu/"],"contacts":[{"name":"Mark Tehranipoor","email":"tehranipoor@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Farimah Farahmandi","email":"farimah@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Tao Zhang","email":"tao.zhang@ufl.edu","affiliation":"University of Florida"}],"affiliation":"University of Florida"},{"category":"FPGA Security","vulnerability-attack":"Enabling authentication, assurance and traceability of FPGA supply chain using Blockchain technology","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Confidence level of device authenticity","security-metric-description":null,"trl":"4","description":["The framework is going to utilize the Blockchain technology as a decentralized ledger to manage the transactions in the modern FPGA supply chain in a trustworthy way, rejecting counterfeit devices and IP infringement. Both public (e.g. ECID) and intrinsic (e.g. PUF CRPs) will be enrolled on blockchain at registration phase to serve as the trust anchor. The IP signatures will be stored on blockchain as well. Upon product verification request, the signatures and chip information would be read back to blockchain to figure out whether the trustworthiness of either FPGA IC or IP is suspected."],"links":["https://fics.institute.ufl.edu/"],"contacts":[{"name":"Mark Tehranipoor","email":"tehranipoor@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Farimah Farahmandi","email":"farimah@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Tao Zhang","email":"tao.zhang@ufl.edu","affiliation":"University of Florida"}],"affiliation":"University of Florida"},{"category":"SoC Security","vulnerability-attack":"Security-Property-Based Vulnerability Identification Against Fault-Injection Attacks","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Identification of the exact time and locations of security-property violations in ICs and protections with low cost.","security-metric-description":null,"trl":"7","description":["The framework determined the exact time and locations that are vulnerable to fault-injection attacks in ICs to make the high-level security properties more executable, thus, it contributes to enable the CAD tool to protect the circuits with more specific and lower-cost countermeasures. The experiments include 6 executable security properties in AES FSM, SHA FSM, RSA FSM and AES key-scheduling module. Fault simulations using Z01X and the overhead analysis have shown its correctness and low cost."],"links":["https://fics.institute.ufl.edu/"],"contacts":[{"name":"Mark Tehranipoor","email":"tehranipoor@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Farimah Farahmandi","email":"farimah@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Fahim Rahman","email":"fahimrahman@ufl.edu","affiliation":"University of Florida"}],"affiliation":"University of Florida"},{"category":"SoC Security","vulnerability-attack":"Design Security Engine framework to protect SoC against vulnerabilities","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"N/A","security-metric-description":null,"trl":"1","description":["Security Engine (SE) works as a root of trust of an SoC that provide security services against different attacks like supply chain attacks, fault injection, side channel attack and malicious hardware component. SE controls security aspects of SoC like key management, asset protection, debug and access control etc using security policies and secure protocols."],"links":["https://fics.institute.ufl.edu/"],"contacts":[{"name":"Mark Tehranipoor","email":"tehranipoor@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Farimah Farahmandi","email":"farimah@ece.ufl.edu","affiliation":"University of Florida"}],"affiliation":"University of Florida"},{"category":"SoC Security","vulnerability-attack":"Identifying Security Assets in a design","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Confidentiality Verification (asset leakage)","security-metric-description":null,"trl":"2","description":["For a given design, a set of primary assets, trusted and untrusted observable points are defined. Given these inputs the tool performs a structural analysis to identify all the intermediate components in the design that are in the fan-out of the primary asset. Then using information leakage, fault propagation and power side channel analysis generates a set of secondary assets that carry information regarding the primary asset. This tool works at the Register Transfer Level."],"links":[""],"contacts":[{"name":"Nusrat Farzana Dipu","email":"ndipu@ufl.edu","affiliation":"University of Florida"},{"name":"Avinash Ayalasomayajula","email":"ayalasomayajul.a@ufl.edu","affiliation":"University of Florida"},{"name":"Mark Tehranipoor","email":"tehranipoor@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Farimah Farahmandi","email":"","affiliation":"University of Florida"},{"name":"Fahim Rahman","email":"","affiliation":"University of Florida"}],"affiliation":"University of Florida"},{"category":"Probing","vulnerability-attack":"Layout-driven Assessment of Probing Attack","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Exposed Area to Probing Attack, Detects vulnerable area on metal wires in the design\'s layout to probing attack","security-metric-description":null,"trl":"7","description":["This tool scans the design\'s physical layout and find vulnerable exposed area of metal wires to probing attack. Based on the exposed area feedback, the layout of the chip could be redesigned to mitigate the threat from probing attack."],"links":[""],"contacts":[{"name":"Mark Tehranipoor","email":"tehranipoor@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Domenic Forte","email":"dforte@ece.ufl.edu","affiliation":"University of Florida"}],"affiliation":"University of Florida"},{"category":"Information Leakage","vulnerability-attack":"HW Weakness and Vulnerability Detection","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Number of common HDL coding style weaknesses and design vulnerabilities, hardware Trojans, backdoors, and other undocumented logic functions","security-metric-description":null,"trl":"Not Available","description":["The product enables a wide range of pre-silicon design assurance solutions for ASIC and FPGA flows. Pre-packaged methods and apps include detection of hardware weaknesses - including a subset of CWE entries - deadlock conditions, redundant logic that could lead to vulnerabilities, leakage and corruption of security assets (violation of confidentiality and integrity requirements), fault injection attacks."],"links":["https://onespin.com/solutions/trust-security"],"contacts":[{"name":"John Hallman","email":"john.hallman@onespin.com","affiliation":"OneSpin Solutions"}],"affiliation":"OneSpin Solutions"},{"category":"Probing","vulnerability-attack":"Trigger and Payload Detection","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Number of suspicious triggers and other code structures reported and associated severity level","security-metric-description":null,"trl":"Not Available","description":["The solution provides an extensible and customizable platform for pre-silicon hardware trust and security verification and assurance in ASIC and FPGA flows. It includes several checks that detect vulnerabilities and weaknesses, including trigger circuitry, deadlock conditions, information leakage, redundant logic, dead code. The platform leverages advanced design structural analysis engines, formal engines, and detection rules. The user can add additional checks or selectively disable existing checks. The platform generates a concise, actionable assessment report."],"links":["https://onespin.com/solutions/trust-security"],"contacts":[{"name":"John Hallman","email":"john.hallman@onespin.com","affiliation":"OneSpin Solutions"}],"affiliation":"OneSpin Solutions"},{"category":"Logic Locking","vulnerability-attack":"SeqL: Scan-Chain Locking and a Broad Security Evaluation","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Incorrect key decryption","security-metric-description":null,"trl":"3","description":["SeqL locks scan-chains to ensure output corruption in the functional mode of operation. The resulting design is evaluated using a broad class of state-of-the-art logic-locking attacks including SAT, SMT, FALL etc."],"links":["https://github.com/seetalpot/SeqL"],"contacts":[{"name":"Seetal Potluri","email":"spotlur2@ncsu.edu","affiliation":"North Carolina State University"},{"name":"Aydin Aysu","email":"aaysu@ncsu.edu","affiliation":"North Carolina State University"}],"affiliation":"North Carolina State University"},{"category":"Reliability","vulnerability-attack":"RelMaster","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Simulates the probability of failure of circuits with and without acceleration","security-metric-description":null,"trl":"Unavailable - Prototype","description":["The software simulates failure rate/lifetime early in the design process and provides feedback about reliability.  The current software covers gate oxide breakdown and middle-of-line time-dependent dielectric breakdown.  Circuit usage and operating conditions are an input and can by adjusted by the user.  Process parameters are also an input and adjusted by the user.  The software takes as input the wearout models developed by reliability engineers, which specify feature-level (transistor, interconnect segment) lifetime distributions.  Circuits can be accelerated by simulation to determine the visibility of various wearout mechanisms in circuits under acceleration to predict circuit qualification test results. Plugin solution seeks to perform reliability analysis."],"links":["https://ieeexplore.ieee.org/document/8438509","https://ieeexplore.ieee.org/document/9184236"],"contacts":[{"name":"Linda Milor","email":"linda.milor@ece.gatech.edu","affiliation":"Georgia Institute of Technology"},{"name":"Yi-Da Wu","email":"yidawu@ece.gatech.edu","affiliation":"Georgia Institute of Technology"}],"affiliation":"Georgia Institute of Technology"}]')},"1gqn":function(e,t){e.exports=function(e){return e&&"object"==typeof e&&"function"==typeof e.copy&&"function"==typeof e.fill&&"function"==typeof e.readUInt8}},"1pIY":function(e,t,n){"use strict";var i=n("2tF/");t.async=new(n("NTcF").AsyncScheduler)(i.AsyncAction)},"1ppg":function(e,t,n){!function(e){"use strict";e.defineLocale("fil",{months:"Enero_Pebrero_Marso_Abril_Mayo_Hunyo_Hulyo_Agosto_Setyembre_Oktubre_Nobyembre_Disyembre".split("_"),monthsShort:"Ene_Peb_Mar_Abr_May_Hun_Hul_Ago_Set_Okt_Nob_Dis".split("_"),weekdays:"Linggo_Lunes_Martes_Miyerkules_Huwebes_Biyernes_Sabado".split("_"),weekdaysShort:"Lin_Lun_Mar_Miy_Huw_Biy_Sab".split("_"),weekdaysMin:"Li_Lu_Ma_Mi_Hu_Bi_Sab".split("_"),longDateFormat:{LT:"HH:mm",LTS:"HH:mm:ss",L:"MM/D/YYYY",