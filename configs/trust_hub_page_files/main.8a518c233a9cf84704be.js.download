u0940 \u0915\u094d\u0937\u0923",ss:"%d \u0938\u0947\u0915\u0947\u0923\u094d\u0921",m:"\u090f\u0915 \u092e\u093f\u0928\u0947\u091f",mm:"%d \u092e\u093f\u0928\u0947\u091f",h:"\u090f\u0915 \u0918\u0923\u094d\u091f\u093e",hh:"%d \u0918\u0923\u094d\u091f\u093e",d:"\u090f\u0915 \u0926\u093f\u0928",dd:"%d \u0926\u093f\u0928",M:"\u090f\u0915 \u092e\u0939\u093f\u0928\u093e",MM:"%d \u092e\u0939\u093f\u0928\u093e",y:"\u090f\u0915 \u092c\u0930\u094d\u0937",yy:"%d \u092c\u0930\u094d\u0937"},week:{dow:0,doy:6}})}(n("wd/R"))},OmwH:function(e,t,n){!function(e){"use strict";e.defineLocale("zh-mo",{months:"\u4e00\u6708_\u4e8c\u6708_\u4e09\u6708_\u56db\u6708_\u4e94\u6708_\u516d\u6708_\u4e03\u6708_\u516b\u6708_\u4e5d\u6708_\u5341\u6708_\u5341\u4e00\u6708_\u5341\u4e8c\u6708".split("_"),monthsShort:"1\u6708_2\u6708_3\u6708_4\u6708_5\u6708_6\u6708_7\u6708_8\u6708_9\u6708_10\u6708_11\u6708_12\u6708".split("_"),weekdays:"\u661f\u671f\u65e5_\u661f\u671f\u4e00_\u661f\u671f\u4e8c_\u661f\u671f\u4e09_\u661f\u671f\u56db_\u661f\u671f\u4e94_\u661f\u671f\u516d".split("_"),weekdaysShort:"\u9031\u65e5_\u9031\u4e00_\u9031\u4e8c_\u9031\u4e09_\u9031\u56db_\u9031\u4e94_\u9031\u516d".split("_"),weekdaysMin:"\u65e5_\u4e00_\u4e8c_\u4e09_\u56db_\u4e94_\u516d".split("_"),longDateFormat:{LT:"HH:mm",LTS:"HH:mm:ss",L:"DD/MM/YYYY",LL:"YYYY\u5e74M\u6708D\u65e5",LLL:"YYYY\u5e74M\u6708D\u65e5 HH:mm",LLLL:"YYYY\u5e74M\u6708D\u65e5dddd HH:mm",l:"D/M/YYYY",ll:"YYYY\u5e74M\u6708D\u65e5",lll:"YYYY\u5e74M\u6708D\u65e5 HH:mm",llll:"YYYY\u5e74M\u6708D\u65e5dddd HH:mm"},meridiemParse:/\u51cc\u6668|\u65e9\u4e0a|\u4e0a\u5348|\u4e2d\u5348|\u4e0b\u5348|\u665a\u4e0a/,meridiemHour:function(e,t){return 12===e&&(e=0),"\u51cc\u6668"===t||"\u65e9\u4e0a"===t||"\u4e0a\u5348"===t?e:"\u4e2d\u5348"===t?e>=11?e:e+12:"\u4e0b\u5348"===t||"\u665a\u4e0a"===t?e+12:void 0},meridiem:function(e,t,n){var i=100*e+t;return i<600?"\u51cc\u6668":i<900?"\u65e9\u4e0a":i<1130?"\u4e0a\u5348":i<1230?"\u4e2d\u5348":i<1800?"\u4e0b\u5348":"\u665a\u4e0a"},calendar:{sameDay:"[\u4eca\u5929] LT",nextDay:"[\u660e\u5929] LT",nextWeek:"[\u4e0b]dddd LT",lastDay:"[\u6628\u5929] LT",lastWeek:"[\u4e0a]dddd LT",sameElse:"L"},dayOfMonthOrdinalParse:/\d{1,2}(\u65e5|\u6708|\u9031)/,ordinal:function(e,t){switch(t){case"d":case"D":case"DDD":return e+"\u65e5";case"M":return e+"\u6708";case"w":case"W":return e+"\u9031";default:return e}},relativeTime:{future:"%s\u5167",past:"%s\u524d",s:"\u5e7e\u79d2",ss:"%d \u79d2",m:"1 \u5206\u9418",mm:"%d \u5206\u9418",h:"1 \u5c0f\u6642",hh:"%d \u5c0f\u6642",d:"1 \u5929",dd:"%d \u5929",M:"1 \u500b\u6708",MM:"%d \u500b\u6708",y:"1 \u5e74",yy:"%d \u5e74"}})}(n("wd/R"))},"Owz/":function(e){e.exports=JSON.parse('[{"category":"Fault Injection","vulnerability-attack":"Fault detection scheme for the cryptographic hardware","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Fault injection/detection evaluation metrics and algorithmic analysis metrics","security-metric-description":null,"trl":"1","description":["Fault detection is becoming more and more essential to the cryptographic circuits protection (for the purpose of fighting against both natural and malicious faults). Our proposed novel fault detection scheme for cryptographic circuits, achieves both high fault detection performance and low-complexity implementation."],"links":["https://ieeexplore.ieee.org/document/8741034"],"contacts":[{"name":"Jiafeng Xie","email":"jiafeng.xie@villanova.edu","affiliation":"Villanova University"}],"affiliation":"Villanova University"},{"category":"Supply Chain","vulnerability-attack":"End-to-end traceability of ICs for protecting the supply chain for recycling","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"N/A","security-metric-description":null,"trl":"3","description":["The proposed infrastructure can provide a robust and low-cost way of protecting the supply chain from IC recycling. The traceability of the IC in the supply chain can be enabled by constructing a chain of trust among the manufacturer, distributors, and end-users. A small passive RFID tag to be attached to the package of a chip. Any entity in the supply chain can verify a chip\'s authenticity by using a commercial RFID reader (or a smartphone). "],"links":["https://ieeexplore.ieee.org/document/8760418"],"contacts":[{"name":"Ujjwal Guin","email":"ujjwal.guin@auburn.edu","affiliation":"Auburn University"},{"name":"Yuqiao Zhang","email":"yuqiao.zhang@auburn.edu","affiliation":"Auburn University"}],"affiliation":"Auburn University"},{"category":"Fault Injection","vulnerability-attack":"ATPG guided fault injection for secret key extraction","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Asset information leakage","security-metric-description":null,"trl":"2","description":["The method uses the constrained stuck-at fault based testing approach to generate the test patterns to leak the secret key from the circuit. It utilizes a commercial ATPG tool to generate the test pattern which sensitizes the effect of key-bit(s) to observable output while constraining the other key-bit(s) in the circuit that blocks its propagation. These generated test patterns along with a commercial fault injection tool can be used to reveal the secret key from any key-dependent circuit."],"links":["https://arxiv.org/abs/2007.10512"],"contacts":[{"name":"Ujjwal Guin","email":"ujjwal.guin@auburn.edu","affiliation":"Auburn University"},{"name":"Ayush Jain","email":"ayush.jain@auburn.edu","affiliation":"Auburn University"},{"name":"Mir Tanjidur Rahman","email":"mir.rahman@ufl.edu","affiliation":"University of Florida"}],"affiliation":"Auburn University and University of Florida"},{"category":"Logic Locking","vulnerability-attack":"Topology-guided attack on logic locking and its countermeasure","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Success rate and misprediction rate","security-metric-description":null,"trl":"3","description":["The attack exploits the structural vulnerability of the gate-level netlist. Due to the repeated usage of unit functions in the design, a self-referencing topological-guided and oracle-less attack can be performed on the design and the key values can be recovered from the logic locked circuits. A countermeasure is also developed to prevent this attack by inserting the key gates within a unique unit function or by locking all the repeated unit functions."],"links":["http://www.eng.auburn.edu/~uguin/publications.html"],"contacts":[{"name":"Ujjwal Guin","email":"ujjwal.guin@auburn.edu","affiliation":"Auburn University"},{"name":"Yuqiao Zhang","email":"yuqiao.zhang@auburn.edu","affiliation":"Auburn University"},{"name":"Ayush Jain","email":"ayush.jain@auburn.edu","affiliation":"Auburn University"},{"name":"Pinchen Cui","email":"pinchen@auburn.edu","affiliation":"Auburn University"},{"name":"Ziqi Zhou","email":"ziqi.zhou@auburn.edu","affiliation":"Auburn University"}],"affiliation":"Auburn University"},{"category":"Supply Chain","vulnerability-attack":"Detecting Recycled SoCs by Exploiting Aging Induced Biases in Memory Cells","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Memory power-up state","security-metric-description":null,"trl":"3","description":["The proposed solution can effectively detect any recycled SoCs even if they have been circulated in the market. The detection approach is based on the observation that an unused/new SRAM memory array will always obtain a approximately equal number of logic 1s and logic 0s during the power-up.  Once an IC is used in the field, the ratio of logic 1 and logic 0 will be skewed due to aging. By observing this ratio at the start-up state of an embedded SRAM, recycled SoCs can be detected."],"links":[""],"contacts":[{"name":"Ujjwal Guin","email":"ujjwal.guin@auburn.edu","affiliation":"Auburn University"},{"name":"Wendong Wang","email":"","affiliation":"Auburn University"},{"name":"Charles Harper","email":"","affiliation":"Auburn University"},{"name":"Adit D. Singh","email":"","affiliation":"Auburn University"}],"affiliation":"Auburn University"},{"category":"Supply Chain","vulnerability-attack":"A Blockchain-Based Framework for Supply Chain Provenance","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Traceability","security-metric-description":null,"trl":"2","description":["The electronics supply chain\'s complexity has grown significantly due to globalization in the 21st century. Electronic parts are now manufactured, distributed, and sold globally. Ensuring the supply chain\'s security and integrity has become extremely challenging, especially the provenance of microelectronics and commercial off-the-shelf (COTS) parts. We have developed a non-destructive way of ensuring electronic parts\' traceability in the supply chain using blockchain technology. The proposed framework is built upon a permissioned blockchain. Hyperledger is used for implementing this framework."],"links":["https://ieeexplore.ieee.org/abstract/document/8884089"],"contacts":[{"name":"Ujjwal Guin","email":"ujjwal.guin@auburn.edu","affiliation":"Auburn University"},{"name":"Pinchen Cui","email":"","affiliation":"Auburn University"},{"name":"Daniel DiMase","email":"","affiliation":"Aerocyonics"}],"affiliation":"Auburn University and Aerocyonics"},{"category":"PUFs","vulnerability-attack":"Security IP","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"N/A","security-metric-description":null,"trl":"2","description":["Existing attacks against memory-based physical unclonable functions (mPUFs) mostly rely on invasive or semi-invasive techniques, where the attacker requires physical access to the target device, which is not always feasible. Moreover, the attacker leaves traces on the device due to the semi-invasive or invasive nature of those attacks. In this project, our proposed novel side-channel information that is used to mount a practical and efficient non-invasive attack against mPUFs without requiring any access to the target device. We also develop countermeasures against the proposed attacks to generate cryptographically strong unclonable secret keys."],"links":[""],"contacts":[{"name":"Tauhidur Rahman","email":"rahman.tauhi@gmail.com","affiliation":"Florida International University"}],"affiliation":"Florida International University"},{"category":"Fault Injection","vulnerability-attack":"Error detection constructions for inversions in finite fields","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Thwarting error injections for natural and malicious faults","security-metric-description":null,"trl":"1","description":["Inversions in finite fields are of prominent importance in cryptographic hardware and embedded systems. Thwarting attacks and having countermeasures are important to counter such vulnerabilities. We are in the process of providing error detection schemes for such constructions."],"links":[""],"contacts":[{"name":"Alvaro Cintas Canto","email":"","affiliation":"University of South Florida"},{"name":"Mehran Mozaffari Kermani","email":"mehran2@usf.edu","affiliation":"University of South Florida"}],"affiliation":"University of South Florida"},{"category":"Supply Chain","vulnerability-attack":"AuthentiMem: A web-based Platform to Identify Counterfeit Memory Chips","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"N/A","security-metric-description":null,"trl":"2","description":["Memory chips are the key components in most electronic systems. However, with the globalization of the semiconductor supply chain, many commercially available memory chips are fabricated worldwide in untrusted facilities. Therefore, counterfeit memory chips and modules easily enter the supply chain in different formats such as remarking, regrading, recycling, etc. In this project, we develop a web-based platform to identify volatile and non-volatile counterfeit memory chips. "],"links":["http://www.ece.uah.edu/~mtr0011/index.html#!/","http://www.csee.usf.edu/~tjneal/index.html"],"contacts":[{"name":"Tauhidur Rahman","email":"rahman.tauhid@gmail.com","affiliation":"Florida International University"},{"name":"Neal Tempestt","email":"tjneal@usf.edu","affiliation":"University of South Florida"}],"affiliation":"Florida International University and University of South Florida"},{"category":"IoT Security","vulnerability-attack":"Randomized Orthogonal Analog Pulse Coded Secure High Volume Data Communication in IoT Devices","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"N/A","security-metric-description":null,"trl":"1","description":["With the ever-increasing trend of IoT devices in various applications, the secure, reliable, and high-volume data communication without overburdening the existing wireless network bandwidth is becoming a challenging task. Limited computational power in low-power, smaller foot-print IoT devices also prohibits sophisticated digital processing and security algorithms. The overarching goal of the proposed IP is, therefore, a resource-efficient, reliable, and easy-to-deploy computational platform for spectrum-efficient and secure data telemetry. We integrate a novel modified Hermite Polynomial (MHP) based orthogonal pulses and their time-shifted versions for spectrum-efficient data encoding, and randomize the pulses with emerging and energy-efficient high-quality random numbers for secure high volume wireless data communication."],"links":["http://www.ece.uah.edu/~mtr0011/index.html#!/","https://labs.uab.edu/mrhaider/"],"contacts":[{"name":"Tauhidur Rahman","email":"rahman.tauhid@gmail.com","affiliation":"Florida International University"},{"name":"Rafiqul Haider","email":"mrhaider@uab.edu","affiliation":"University of Alabama in Birmingham"}],"affiliation":"Florida International University and University of Alabama in Birmingham"},{"category":"Hardware Trojan","vulnerability-attack":"Hardware Trojan Detection in Power Electronic Circuits","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"","security-metric-description":null,"trl":"1","description":["Compromised power electronics, due to firmware attacks and hardware Trojans, in a flight computer can jeopardize the safety and security of an Unmanned Aerial Vehicle(UAV). They can maliciously alter sensor measurements or control commands to make a UAV to take disastrous moves. Unfortunately, most of these attacks are difficult to detect before deploying components in the system. Therefore, detecting compromised behavior run-time is important, while it is challenging at the same time. In this work, we propose to build machine learning-based intrusion detection systems  (IDSs) to be deployed at the power electronics/microcontroller level such that it can deal with malicious data/control commands initiated due to hardware attacks."],"links":["http://www.ece.uah.edu/~mtr0011/index.html#!/","https://rahman.eng.fiu.edu/"],"contacts":[{"name":"Tauhidur Rahman","email":"rahman.tauhid@gmail.com","affiliation":"Florida International University"},{"name":"Mohammad Ashiqur Rahman","email":"marahman@fiu.edu","affiliation":"Florida International University"}],"affiliation":"Florida International University"},{"category":"Side Channel Analysis","vulnerability-attack":"Cryptographic Accelerators","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Side-channel countermeasures  ","security-metric-description":null,"trl":"3","description":["Design methods for secure and power efficient cryptographic accelerators for wide range of applications including resource constrained devices, and high performance SoCs. Design provide different assurance methods as well to tackle supply chain threats such as counterfeiting and IP protection"],"links":[""],"contacts":[{"name":"Eslam Tawfik","email":"Tawfik.10@osu.edu","affiliation":"The Ohio State University"}],"affiliation":"The Ohio State University"},{"category":"PUFs","vulnerability-attack":"Metallization based Physically Unclonable Function (PUF) for embedded systems and Systems on a Chip (SoC)","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Authentication/ Identification of Silicon, cryptography ","security-metric-description":null,"trl":"3","description":["This IP features a fully passive PUF cell by leveraging metal-via resistance and already existing ADC available on most microcontrollers and SoCs. The passive metallization geometry uses the available vertical space on top of active circuitry which would otherwise be unused. The IP has been verified on silicon and the native instability and bit error rate are 1.2% and 0.11% respectively. "],"links":[""],"contacts":[{"name":"Nima Maghari","email":"maghari@ece.ufl.edu","affiliation":"University of Florida"}],"affiliation":"University of Florida"},{"category":"PUFs","vulnerability-attack":"Negative impedance based Physically Unclonable Function (PUF)","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Authentication/ Identification of Silicon, cryptography ","security-metric-description":null,"trl":"3","description":["This IP leverages weak positive feedback to dramatically improve the stability of active PUF cells based on transistor entropy. Normally, PUF cells with small offsets would normally result in unstable bits, however the technique sensitizes the gain of the circuit to smaller offsets. Thus, cells which would be unstable are made stable by selective gain boosting. The IP has been verified on silicon and the native instability and bit error rate are 1.06% and 0.11% respectively."],"links":[""],"contacts":[{"name":"Nima Maghari","email":"maghari@ece.ufl.edu","affiliation":"University of Florida"}],"affiliation":"University of Florida"},{"category":"PUFs","vulnerability-attack":"Stochastic ADC based PUF","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Authentication/Identification of Silicon and cryptography ","security-metric-description":null,"trl":"3","description":["This IP leverages the random offset of comparators to quantize input signals and extract a physical unclonable function. Furthermore, traditional comparators can be replaced with fully synthesizable comparators made by combining different logic gates. Both cases were verified on silicon and shows excellent reliability with an intra-HD of less than 0.96% across 0.8V-1.4V voltage supply and less than 0.15% for temperatures up to 80\xb0C. An optimized design is calculated to only require 34.5 pJ/bit at a throughput of 4Mb/s."],"links":[""],"contacts":[{"name":"Nima Maghari","email":"maghari@ece.ufl.edu","affiliation":"University of Florida"}],"affiliation":"University of Florida"},{"category":"PUFs","vulnerability-attack":"Energy Harvesting and Sensors Based Physically Unclonable Function for Cyber-physical Systems","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"IC piracy, counterfeiting, secure authentication, and key management","security-metric-description":null,"trl":"1","description":["Building Physically Unclonable Functions (PUFs) from energy harvesting devices and sensors have the potential to mitigate cyber-threats in cyber-physical systems with minimal redesign costs and performance penalties. A novel PUF design methodology based on energy harvesting devices and sensors is proposed. The proposed methodology uses eight sensors or energy harvesting devices along with a microcontroller. As proof of concept, we have designed a PUF based on piezo sensors that can generate 128-bit responses. A novel solar cell based PUF that leverages the intrinsic variations present in solar cells is proposed. Further, a novel PUF design using thermistor temperature sensors is also developed."],"links":["http://hthapliyal.engr.uky.edu/"],"contacts":[{"name":"Himanshu Thapliyal","email":"hthapliyal@uky.edu","affiliation":"University of Kentucky, Lexington"},{"name":"Carson Labrado","email":"","affiliation":"University of Kentucky, Lexington"}],"affiliation":"University of Kentucky, Lexington"},{"category":"Side Channel Analysis","vulnerability-attack":"Exploration of Non-Volatile MTJ/CMOS Circuits for DPA Resistant Embedded Hardware:","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Side-Channel Resilience, DPA-Resistance, DPA Countermeasures, Low-Power Cryptographic Hardware","security-metric-description":null,"trl":"1","description":["Magnetic tunnel junction (MTJ) and CMOS  (MTJ/CMOS) based Logic-in-Memory (LiM) circuits have nearly zero leakage and appropriate to design low-power hardware. We have explored the usefulness of designing MTJ/CMOS based cryptographic circuits and evaluated their resilience against DPA attacks. A novel approach to building cryptographic hardware in MTJ/CMOS circuits using a Look-Up Table (LUT) based approach is proposed. We found that the MTJ/CMOS based PRESENT-80 is resistant against DPA attacks and is low-power and energy-efficient compared to standard CMOS base design. The low-energy and DPA resistant property can make hybrid MTJ/CMOS circuits a suitable candidate for building non-volatile, low-energy, and compact embedded cryptographic hardware."],"links":["http://hthapliyal.engr.uky.edu/"],"contacts":[{"name":"Himanshu Thapliyal","email":"hthapliyal@uky.edu","affiliation":"University of Kentucky, Lexington"},{"name":"Carson Labrado","email":"","affiliation":"University of Kentucky, Lexington"}],"affiliation":"University of Kentucky, Lexington"},{"category":"Side Channel Analysis","vulnerability-attack":"Adiabatic Logic-In-Memory Architecture for Low-Power  Cryptographic Hardware","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Low-Power Cryptographic Hardware, Low-Power Methodology","security-metric-description":null,"trl":"1","description":["Logic-In-Memory (LIM) architecture can be designed by the hybridization of Magnetic Tunnel Junction (MTJ) devices and CMOS transistors. However, hybrid CMOS/MTJ based LIM architecture suffers from significant dynamic power consumption. Adiabatic logic is one of the low-power design techniques to design energy-efficient hardware. Therefore, we apply the adiabatic logic in hybrid CMOS/MTJ based designs to propose the novel concept of adiabatic Logic-In-Memory (ALIM) circuits. The proposed ALIM based CMOS/MTJ circuits have reduced dynamic power consumption as compared to the existing CMOS/MTJ circuits by using the energy recovery property. The proposed ALIM architecture can be used to design cryptographic circuits with low-area, low-power, and low-energy consumption."],"links":["http://hthapliyal.engr.uky.edu/","https://uky.flintbox.com/?embed=true#technologies/2a2ce651-e745-4642-a14a-6cff70d9f3d7"],"contacts":[{"name":"Himanshu Thapliyal","email":"hthapliyal@uky.edu","affiliation":"University of Kentucky, Lexington"},{"name":"Carson Labrado","email":"","affiliation":"University of Kentucky, Lexington"}],"affiliation":"University of Kentucky, Lexington"},{"category":"Hardware Trojan","vulnerability-attack":"Analog IC Hardware Assurance Through Deep Learning","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Detection Accuracy; Predicted Time to Failure","security-metric-description":null,"trl":"2","description":["A deep learning-based approach has been developed to detect hardware trojans in analog ICs. Whereas prior research has been dedicated to detecting trojans in digital ICs, hardware assurance of analog/RF ICs remains relatively unexplored. ICs with process reliability trojans appear legitimate on all wiring layers (including metal and polysilicon), making them resistant to widely used detection techniques, including optical inspection and side-channel analysis. Our approach has shown success in detecting these and other forms of hardware trojans, as well as counterfeit devices, in either post-production testing or field usage.  This further enables the run-time monitoring of device reliability and integrity. "],"links":["https://calce.umd.edu/","https://enme.umd.edu/clark/faculty/506/Michael-Azarian"],"contacts":[{"name":"Varun Khemani","email":"vkheman@umd.edu","affiliation":"University of Maryland College Park"},{"name":"Michael H. Azarian","email":"mazarian@umd.edu","affiliation":"University of Maryland College Park"}],"affiliation":"University of Maryland College Park"},{"category":"Post Quantum","vulnerability-attack":"Efficient Architectures for SIKE","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Post-quantum Cryptography","security-metric-description":null,"trl":"3","description":["Efficient and fast architectures and IPs developed for supersingular isogeny key encapsulation mechanism. "],"links":[""],"contacts":[{"name":"Reza Azarderakhsh","email":"razarderakhsh@fau.edu","affiliation":"Florida Atlantic University"},{"name":"Brian Koziel","email":"","affiliation":"Florida Atlantic University"},{"name":"Rami El Khatib","email":"","affiliation":"Florida Atlantic University"}],"affiliation":"Florida Atlantic University"},{"category":"Crypto","vulnerability-attack":"High Performance and fast IP for Curve25519 and Ed25519","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Public key cryptography","security-metric-description":null,"trl":"3","description":["Efficient and fast architectures are developed for key exchange and digital signature over Curve25519 and Ed25519"],"links":[""],"contacts":[{"name":"Reza Azarderakhsh","email":"razarderakhsh@fau.edu","affiliation":"Florida Atlantic University"},{"name":"Mojtba Bishe Niasar","email":"","affiliation":"Florida Atlantic University"}],"affiliation":"Florida Atlantic University"},{"category":"PUFs","vulnerability-attack":"Aysnchronous Reset Physically Unclonable Function (ARES-PUF)","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Device authentication and secure key generation","security-metric-description":null,"trl":"2","description":["A physically unclonable function based on null-conventional logic that can be used for secure key generation and device authentication of asynchronous circuits including analog and mixed signal circuits."],"links":["fics.institute.ufl.edu"],"contacts":[{"name":"Rabin Yu Acharya","email":"","affiliation":"University of Florida"},{"name":"Jia Di","email":"","affiliation":"University of Arkansas"},{"name":"Domenic Forte","email":"dforte@ece.ufl.edu","affiliation":"University of Florida"}],"affiliation":"University of Florida"},{"category":"Hardware Trojan","vulnerability-attack":"Hybrid Approach for Rapid Hardware Trojan Scanner (HARTS)","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Physical Inspection using nano-imaging","security-metric-description":null,"trl":"5","description":["The purpose of the HARTS tool is to detect hardware Trojans inserted by untrusted foundry. By Trojan insertion, we mean addition, deletion, or modification of logic gates. In HARTS, SEM image of an IC is analyzed by computer vision techniques and using deep learning tools, we identify, localize and classify logic gates. Later we match our result with the layout to find out any kind of discrepancy."],"links":["https://fics.institute.ufl.edu/"],"contacts":[{"name":"Navid Asadizanjani","email":"nasadi@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Mark Tehranipoor","email":"tehranipoor@ece.ufl.edu","affiliation":"University of Florida"}],"affiliation":"University of Florida"},{"category":"Secure Packaging","vulnerability-attack":"RRAM & NEMS based Devices to Protect Advanced Packaging Against Reverse-Engineering","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Protect 2.5D and 3D structured ICs from reverse engineering at production line, through life cycle operation, and at the end of life recycling","security-metric-description":null,"trl":"3","description":["Advanced IC packages involve multiple dies combined via an interconnection layer known as an interposer. This interposer contains nano sized horizontal and vertical copper connections to provide connectivity between dies and between the larger substrate (PCB). These copper connections of an IC package can be identified, characterized, and then used to derive the complex valuable circuit design.RRAM and NEMS devices offer solid state and mechanical solutions at the scale necessary for reconfigurable circuitry that can be scaled into current IC fabrication process flows. These solutions will enable control over a circuit design to only operate in trusted environments."],"links":["https://fics.institute.ufl.edu/"],"contacts":[{"name":"Navid Asadizanjani","email":"nasadi@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Mark Tehranipoor","email":"tehranipoor@ece.ufl.edu","affiliation":"University of Florida"}],"affiliation":"University of Florida"},{"category":"Secure Packaging","vulnerability-attack":"Secure Active Interposer Based Split Fabrication","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Hamming Distance, SAT Execution time","security-metric-description":null,"trl":"1","description":["This effort is aimed to safeguard heterogeneous ICs from IP piracy related threats. In the proposed fabrication model, the interposer layer, which is conventionally used in 2.5D IC packaging, will be used as a means of ensuring IP security. The interposer will be made active by incorporating active circuitry or portion of the IP design. The interposer, being fabricated in a low tech trusted facility will remain concealed from potential adversaries, while the rest of the IP is fabricated in untrusted premises. So in effect, without knowledge about the active interposer circuit, the IP design will be undecipherable, hence ensuring protection against IP piracy."],"links":["https://fics.institute.ufl.edu/"],"contacts":[{"name":"Navid Asadizanjani","email":"nasadi@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Mark Tehranipoor","email":"tehranipoor@ece.ufl.edu","affiliation":"University of Florida"}],"affiliation":"University of Florida"},{"category":"Secure Packaging","vulnerability-attack":"Secure FPGA Based Split Fabrication","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Hamming Distance, SAT Execution time","security-metric-description":null,"trl":"1","description":["This effort is aimed to safeguard heterogeneous ICs from IP piracy related threats. In the proposed fabrication model, an FPGA will be used in 2.5D IC packaging, as a means of ensuring IP security. The FPGA will implement a portion of the IP design. The FPGA, being configured by the IP designer will remain concealed from potential adversaries, while the rest of the IP is fabricated in untrusted premises. So in effect, without knowledge about the soft-core circuit implemented in the FPGA, the IP design will be undecipherable, hence ensuring protection against IP piracy."],"links":["https://fics.institute.ufl.edu/"],"contacts":[{"name":"Navid Asadizanjani","email":"nasadi@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Mark Tehranipoor","email":"tehranipoor@ece.ufl.edu","affiliation":"University of Florida"}],"affiliation":"University of Florida"},{"category":"PCB Assurance","vulnerability-attack":"PCB Component Detector from Optical Images","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Automated bill of material generation","security-metric-description":null,"trl":"3","description":["This tool locates all components (e.g., resistors, capacitors, IC\u2019s, etc.) within an optical image of a PCB. This is an initial step toward automatic bill of materials extraction (AutoBoM). The PCB Component Detector can be used for quality assurance, reverse engineering, and hardware Trojan detection."],"links":["https://fics.institute.ufl.edu/"],"contacts":[{"name":"Navid Asadizanjani","email":"nasadi@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Mark Tehranipoor","email":"tehranipoor@ece.ufl.edu","affiliation":"University of Florida"}],"affiliation":"University of Florida"},{"category":"PCB Assurance","vulnerability-attack":"FICS PCB Image Collection","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Automated Bill of Material for PCBs","security-metric-description":null,"trl":"3","description":["The AutoBoM project provides assurance and BoM properties for PCB images. Toward this end, a robust database of images must be maintained, regularly updated with up-to-date PCB samples, and rigorously analyzed for common features. Separate tools and solutions work together to facilitate this database management: A ViperX 300 robot arm provides high-precision imaging capabilities, particularly for acquiring data used in SHADE algorithm development, A MariaDB relational database tracks all relevant data, imaging conditions, ground truth annotations, board manufacturer, and other information to assist traceability and map to domain knowledge, A networked server hosts this information and provides the computing capabilities necessary to operate on acquired data."],"links":["https://fics.institute.ufl.edu/"],"contacts":[{"name":"Navid Asadizanjani","email":"nasadi@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Mark Tehranipoor","email":"tehranipoor@ece.ufl.edu","affiliation":"University of Florida"}],"affiliation":"University of Florida"},{"category":"PCB Assurance","vulnerability-attack":"ALDA \u2013 Automatic Logo Detector and Analyzer & SynthLogo","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Automated Bill of Materials for PCBs","security-metric-description":null,"trl":"3-4","description":["These are two different tools that work together. ALDA is built to detect and identify logos from the PCB, mainly Logos marked or etched on the ICs. Cutting edge Deep Neural Network techniques are used to identify and match the logos from 824 different brand categories, with more added on the fly. This also aids AMDA(Automatic Marking Detector and Analyzer) in identifying spec sheets for components. SynthLogo is a 10 million+ images dataset built automatically to train and identify logos from any instance within a PCB. This is essential to train the AI for ALDA, but can also be used to seamlessly implant IC Images with logos of other companies to test other detection networks for assurance efficiency."],"links":["https://fics.institute.ufl.edu/"],"contacts":[{"name":"Navid Asadizanjani","email":"nasadi@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Mark Tehranipoor","email":"tehranipoor@ece.ufl.edu","affiliation":"University of Florida"}],"affiliation":"University of Florida"},{"category":"PCB Assurance","vulnerability-attack":"PCB Marking Identifier from Optical Images","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Automated Bill of Material for PCBs","security-metric-description":null,"trl":"2","description":["This tool locates and identifies all text (e.g. on-board silkscreen text, on-component text, etc.) within an optical image of a PCB. On-board silkscreen text such as reference designators can be used to help classify PCB components (e.g., components with \u201cR\u201d on-board reference designators are typically resistors). On-component text can be used to help identify PCB components (e.g., resistors with \u201c220\u201d on-component text typically have resistive values of 220 ohms). The PCB Marking Identifier can be used for quality assurance, reverse engineering, and hardware trojan detection."],"links":["https://fics.institute.ufl.edu/"],"contacts":[{"name":"Navid Asadizanjani","email":"nasadi@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Mark Tehranipoor","email":"tehranipoor@ece.ufl.edu","affiliation":"University of Florida"}],"affiliation":"University of Florida"},{"category":"PCB Assurance","vulnerability-attack":"S3A: Semi-Supervised Semantic Annotator","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Automated Bill of Material","security-metric-description":null,"trl":"4","description":["A substantial portion of the AutoBoM project involves detecting surface-mount devices (SMDs) on the PCB in question. To facilitate such detection, neural networks and other machine-learning solutions learn from previously annotated boards, where all SMDs are denoted by a pixel mask over the original image. However, few software tools are capable of handling images with such high resolution, large numbers of components, and complex shapes. S3A fills these gaps, providing high-performance and high-accuracy labeling capabilities for semantic image segmentation."],"links":["https://fics.institute.ufl.edu/"],"contacts":[{"name":"Navid Asadizanjani","email":"nasadi@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Mark Tehranipoor","email":"tehranipoor@ece.ufl.edu","affiliation":"University of Florida"}],"affiliation":"University of Florida"},{"category":"PCB Assurance","vulnerability-attack":"SHADE: Shadow-Based Detection Enhancement for PCB Components","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Automated Bill of Material for PCB","security-metric-description":null,"trl":"3","description":["A substantial portion of the AutoBoM project involves detecting surface-mount devices (SMDs) on the PCB in question. Currently, this entails making an initial estimate of where components might exist and progressively refining that estimation. Once the existence of a component is verified, that component is considered validated. SHADE is a procedure which reduces the significant processing time required to validate large SMDs. By leveraging shadows cast by these components, we can quickly and efficiently determine which locations on a PCB contain valid components."],"links":["https://fics.institute.ufl.edu/"],"contacts":[{"name":"Navid Asadizanjani","email":"nasadi@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Mark Tehranipoor","email":"tehranipoor@ece.ufl.edu","affiliation":"University of Florida"}],"affiliation":"University of Florida"},{"category":"PCB Assurance","vulnerability-attack":"3D-SIM for PCBs ( 3D Surface Imaging and Modelling for PCBs)","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"","security-metric-description":null,"trl":"3","description":["Building a 3D Surface model of a PCB using a photogrammetry based solution from multiple view points. There are two algorithmic scenarios: (1) For end users using handheld devices with a slower yet accurate 3d modeler (2) For companies to use a Robotic arm for fast and accurate 3d modeler for multiple PCB inspection. The algorithm is built for mm level accuracy to be accurate for small components and to be able to identify them, and isolate them from the board level information."],"links":["https://fics.institute.ufl.edu/"],"contacts":[{"name":"Navid Asadizanjani","email":"nasadi@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Mark Tehranipoor","email":"tehranipoor@ece.ufl.edu","affiliation":"University of Florida"}],"affiliation":"University of Florida"},{"category":"PCB Assurance","vulnerability-attack":"ECLAD-Net (Electronic Component Localization and Detection Network)","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Automated Bill of Material for PCB","security-metric-description":null,"trl":"4","description":["Building a 3D Surface model of a PCB using a photogrammetry based solution from multiple view points. There are two algorithmic scenarios: (1) For end users using handheld devices with a slower yet accurate 3d modeler (2) For companies to use a Robotic arm for fast and accurate 3d modeler for multiple PCB inspection. The algorithm is built for mm level accuracy to be accurate for small components and to be able to identify them, and isolate them from the board level information."],"links":["https://fics.institute.ufl.edu/"],"contacts":[{"name":"Navid Asadizanjani","email":"nasadi@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Mark Tehranipoor","email":"tehranipoor@ece.ufl.edu","affiliation":"University of Florida"}],"affiliation":"University of Florida"},{"category":"IC Authentication","vulnerability-attack":"IC Package Terahertz (THz) Structural, Chemical, and Electrical Fingerprint for Counterfeit Verification","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"THz signal analysis and processing to determine counterfeit IC at high throughput necessary for high volume manufacturing","security-metric-description":null,"trl":"","description":["THz metrology enables rapid material characterization capable of determining presence of unexpected materials in counterfeit ICs. Blacktopping (Counterfeit IC, where an IC is maliciously relabeled) layers are detected using THz time-of-flight tomography, and thickness of hidden layers can be detected. Sanded and contaminated components are detected by THz reflection-mode imaging. Differences between inside structures of counterfeit and authentic components are revealed through developing THz transmission imaging. The tool is an automated decision system for classification of authentic vs. counterfeit, accomplished by golden sample comparison or through fingerprinting methods ensuring tampering has not occurred while in untrusted environments."],"links":["https://fics.institute.ufl.edu/"],"contacts":[{"name":"Navid Asadizanjani","email":"nasadi@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Mark Tehranipoor","email":"tehranipoor@ece.ufl.edu","affiliation":"University of Florida"}],"affiliation":"University of Florida"},{"category":"FPGA Security","vulnerability-attack":"FPGA interdiction framework for AI accelerators","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Denial of Service (Availability), Misclassification (Integrity), Model/ AI architecture (confidentiality)","security-metric-description":null,"trl":"2","description":["Field programmable gate arrays (FPGAs) deliver high performance at a low development cost and reconfigurability making them ideal for artificial intelligence (AI) acceleration. Our framework describes how a trusted FPGA can have its IP tampered to make the bitstream malicious. The first stage of the framework defeats FPGA bitstream encryption and authentication, and the second stage inserts Trojans. Lastly, we would develop countermeasures to protect the AI accelerator against the known physical weaknesses of FPGAs."],"links":["https://fics.institute.ufl.edu/"],"contacts":[{"name":"Dhwani Mehta","email":"dhwanimehta@ufl.edu","affiliation":"University of Florida"},{"name":"Jacob Harrison","email":"","affiliation":"University of Florida"},{"name":"Farimah Farahmandi","email":"farimah@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Mark Tehranipoor","email":"tehranipoor@ece.ufl.edu","affiliation":"University of Florida"}],"affiliation":"University of Florida"},{"category":"Hardware Trojan","vulnerability-attack":"Test Generation for Hardware Trojan Detection Using Symbolic Execution","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Rareness of branches inside a RTL codebase","security-metric-description":null,"trl":"4","description":["In this project we leveraged the Symbolic Execution approach that has proved to be powerful for debugging software models in order to find Trojan triggers inside a RTL code. The process starts with translation of RTL code to C-level in order to benefit from Symbolic Engines available at C. This tool generates full sequential test patterns that will direct the execution towards the Trojan trigger."],"links":[""],"contacts":[{"name":"Farimah Farahmandi","email":"farimah@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Mark Tehranipoor","email":"tehranipoor@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Arash Vafaei","email":"arash.vafaei@ufl.edu","affiliation":"University of Florida"}],"affiliation":"University of Florida"},{"category":"PCB Assurance","vulnerability-attack":"Auto-3D (Automated PCB reverse engineering)","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Integrity, Availability, Confidentiality","security-metric-description":null,"trl":"3","description":["Over the past two decades, globalized outsourcing has rendered the printed circuit boards (PCBs) vulnerable to malicious activities and alterations on a global scale. Traditional RE is based on a destructive process of serial sectioning followed by imaging, which is time-consuming, expensive, and error prone. In this research, we introduce a nondestructive approach for printed circuit board (PCB) RE based on X-ray tomography. We plan to automate the reverse engineering with the combination of tomography and advanced 3D image processing."],"links":[""],"contacts":[{"name":"Dhwani Mehta","email":"dhwanimehta@ufl.edu","affiliation":"University of Florida"},{"name":"Mark Tehranipoor","email":"tehranipoor@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Navid Asadizanjani","email":"nasadi@ece.ufl.edu","affiliation":"University of Florida"}],"affiliation":"University of Florida"},{"category":"PCB Assurance","vulnerability-attack":"Board-level trojan test suite development","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Integrity verification","security-metric-description":null,"trl":"1","description":["Trojan test suites have been developed for IC-level trojans, but PCB-level trojans have received little attention. This project is developing a novel suite of PCB trojan benchmarks. In addition to enabling evaluation of countermeasures against PCB trojans and implants, this test suite explores how vulnerable aspects of board designs (e.g., unpopulated component footprints, enable pins on ICs, and insecure inter-component communications) can be exploited to implement system-level attacks."],"links":["https://fics.institute.ufl.edu/"],"contacts":[{"name":"Jacob Harrison","email":"","affiliation":"University of Florida"},{"name":"Paul Calzada","email":"","affiliation":"University of Florida"},{"name":"Mark Tehranipoor","email":"tehranipoor@ece.ufl.edu","affiliation":"University of Florida"}],"affiliation":"University of Florida"},{"category":"FPGA Security","vulnerability-attack":"FPGA Remote Upgrade","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"N/A","security-metric-description":null,"trl":"1","description":["Exploit the vulnerabilities in FPGA remote upgrade"],"links":[""],"contacts":[{"name":"Shang Shi","email":"shang.shi@ufl.edu","affiliation":"University of Florida"},{"name":"Tao Zhang","email":"tao.zhang@ufl.edu","affiliation":"University of Florida"}],"affiliation":"University of Florida"},{"category":"HLS Security","vulnerability-attack":"High-level Synthesis Security Verification","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Detects security violations that can result in confidentiality and integrity violations in the HLS generated RTLs","security-metric-description":null,"trl":"3","description":["HLS security verification framework develops security guidelines for secure HLS development and ensures that serial-to-parallel translation will be secure. It aims to verify the C/C++ implementation of the targeted design for security vulnerabilities. It also ensures that the performance optimizations made by the HLS compiler do not unknowingly introduce security vulnerabilities in the generated RTL."],"links":["https://fics.institute.ufl.edu/"],"contacts":[{"name":"Mark Tehranipoor","email":"tehranipoor@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Farimah Farahmandi","email":"farimah@ece.ufl.edu","affiliation":"University of Florida"}],"affiliation":"University of Florida"},{"category":"HLS Security","vulnerability-attack":"Hardware Locking Using High-Level Synthesis","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"SAT resiliency, overheads, and locking key size","security-metric-description":null,"trl":"2","description":["Locking designs at the higher-level abstraction (C/C++) and performing high-level synthesis on the locked design for adding more confusion to the design."],"links":["https://fics.institute.ufl.edu/"],"contacts":[{"name":"Mark Tehranipoor","email":"tehranipoor@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Farimah Farahmandi","email":"farimah@ece.ufl.edu","affiliation":"University of Florida"}],"affiliation":"University of Florida"},{"category":"IP Security","vulnerability-attack":"Analog IP protection","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Lesser changes to the design, maximizing the confusion to the adversary","security-metric-description":null,"trl":"2","description":["This is a keyless approach where the original design is analyzed to find out interconnects that can be altered to make the design out-of-spec and hardest for the adversary to realize the change."],"links":["https://fics.institute.ufl.edu/"],"contacts":[{"name":"Mark Tehranipoor","email":"tehranipoor@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Farimah Farahmandi","email":"farimah@ece.ufl.edu","affiliation":"University of Florida"}],"affiliation":"University of Florida"},{"category":"Hardware Trojans","vulnerability-attack":"Hardware Trojan in the AMS domain: detection and prevention","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"EM-based hardware trojan insertion from a distance; adversary having the ability to store EM signature from victim chip for post-processing","security-metric-description":null,"trl":"2","description":["In this approach, EM-based trojan insertion and detection techniques are explored. In the attack vector, we consider the adversary can transmit a strong EM signal towards the victim chip from a distance and cause faults in the chip. Also, he can access the side-channel EM from the chip for leaking critical information."],"links":["https://fics.institute.ufl.edu/"],"contacts":[{"name":"Mark Tehranipoor","email":"tehranipoor@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Farimah Farahmandi","email":"farimah@ece.ufl.edu","affiliation":"University of Florida"}],"affiliation":"University of Florida"},{"category":"Watermarking","vulnerability-attack":"Analog IP Protection through watermarking","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Detectability, and Proof of ownership of an IP and IC","security-metric-description":null,"trl":"2","description":["The goal of this project is to develop protection techniques to prove the ownership for pure analog IPs and AMS designs. The project also includes developing methods and automated CAD tools for performing analog watermarking and evaluating the performance on a large array of designs."],"links":["https://www.linkedin.com/in/shahedquadir/"],"contacts":[{"name":"Md Shahed Enamul Quadir","email":"m.enamulguadir@ufl.edu","affiliation":"University of Florida"}],"affiliation":"University of Florida"},{"category":"Logic Locking","vulnerability-attack":"Security Assessment of Dynamically Obfuscated Scan Chain (DOSC) Against Oracle-Guided Attacks","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Resiliency of DOSC-inserted benchmarks against SAT attacks","security-metric-description":null,"trl":"8","description":["This project mathematically and experimentally demonstrated that DOSC exponentially increases the resiliency against key extraction by SAT attack and its variants. The results show that the mathematical estimation of attack complexity correlates to the experimental results with an accuracy of 95% or better. The experiments also show that the DOSC insertion protects ISCAS\u201989 and ITC\u201999 benchmark circuits well while bringing acceptable time, area and power overhead."],"links":["https://fics.institute.ufl.edu/"],"contacts":[{"name":"Mark Tehranipoor","email":"tehranipoor@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Farimah Farahmandi","email":"farimah@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Fahim Rahman","email":"fahimrahman@ece.ufl.edu","affiliation":"University of Florida"}],"affiliation":"University of Florida"},{"category":"Side Channel","vulnerability-attack":"Development of Secured Cryptographic IP Accelerator","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Side channel fault protection","security-metric-description":null,"trl":"3","description":["We will develop symmetric and asymmetric key hardware cryptographic accelerator. Our IPs will include following cryptographic operations: AES (encryption/decryption), RSA (sign, verify), HMAC/ SHA-2 hashing function. Provided solution will be on resister transfer level (RTL)."],"links":["https://fics.institute.ufl.edu/"],"contacts":[{"name":"Mark Tehranipoor","email":"tehranipoor@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Fahim Rahman","email":"fahimrahman@ece.ufl.edu","affiliation":"University of Florida"}],"affiliation":"University of Florida"},{"category":"Access control","vulnerability-attack":"Hardware-Software Cooperated Adversarial Example Generation ","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Unauthorized Access (Permission), Denial of Service (Availability), Misclassification (Integrity), AI Model/System Architecture (Confidentiality), Physical Intrusion (Threat), and Broken System (Vulnerability).","security-metric-description":null,"trl":"2","description":["Artificial Intelligence (AI) systems are widely adopted in safety- and security critical applications, such as autonomous vehicles and biometric recognition systems. Malicious faults and attacks on these systems become a tremendous concern, which potentially could lead to catastrophic consequences. In this work, we propose a threat methodology in which a hybrid hardware-software AI system is physically intruded in order to extract hardware and software parameters for creating intelligent adversarial examples. The samples will be used in breaking unknown related hybrid hardware-software AI systems. They are also used in a reverse procedure in order to make the systems robust."],"links":["https://fics.institute.ufl.edu/"],"contacts":[{"name":"Dhwani Mehta","email":"dhwanimehta@ufl.edu","affiliation":"University of Florida"},{"name":"Jacob Harrison","email":"","affiliation":"University of Florida"},{"name":"Shayan (Sean) Taheri","email":"","affiliation":"University of Florida"},{"name":"Mir Tanjidur Rahman","email":"","affiliation":"University of Florida"},{"name":"Navid Asadizanjani","email":"nasadi@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Mark Tehranipoor","email":"tehranipoor@ece.ufl.edu","affiliation":"University of Florida"}],"affiliation":"University of Florida"},{"category":"Authentication","vulnerability-attack":"EMFORCED: EM-Based Fingerprinting Framework for Remarked and Cloned Counterfeit IC Detection using Machine Learning Classification","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Electromagnetic fingerprinting and post-silicon counterfeit IC detection","security-metric-description":null,"trl":"2","description":["EMFORCED leverages electromagnetic emissions from the clock distribution network of an IC to create a holistic, design-level, fingerprint including both temporal and spatial information. This framework and associated tool-flow can separate near-field electromagnetic fingerprints to differentiate between suspect and authentic ICs."],"links":["https://fics.institute.ufl.edu/"],"contacts":[{"name":"Mark Tehranipoor","email":"tehranipoor@ece.ufl.edu","affiliation":"University of Florida"},{"name":"Domenic Forte","email":"dforte@ece.ufl.edu","affiliation":"University of Florida"}],"affiliation":"University of Florida"},{"category":"Authentication","vulnerability-attack":"Secure Chip ID","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Verification of device provenance","security-metric-description":null,"trl":"N/A","description":["Multibeam\'s MEBL system hard-codes Secure Chip IDs deep inside each IC during routine wafer fabrication, securing devices with an imperceptible physical tag that can be read electronically. MEBL writes the ID in low-lying via layers, making it virtually impossible for hackers to access or modify the ID without destroying the chip. Secure Chip ID offers key benefits: Secure the IC supply chain and protect end-users from counterfeits, Verify identity and provenance of each chip at any point in its lifecycle using standard test equipment, Correlate field data with fabrication data and test results, gaining valuable insights."],"links":["http://www.multibeamcorp.com"],"contacts":[{"name":"Roger Van Art","email":"rvanart@multibeamcorp.com","affiliation":"Multibeam Corporation"},{"name":"Ted Prescop","email":"tprescop@multibeamcorp.com","affiliation":"Multibeam Corporation"},{"name":"Dr. David Lam","email":"","affiliation":"Multibeam Corporation"}],"affiliation":"Multibeam Corporation"},{"category":"Reverse Engineering","vulnerability-attack":"Multilayer Camouflaged Secure Boot For Socs","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Confidentiality, and privacy preserving process of secure boot for reconfigurable architecture.","security-metric-description":null,"trl":"1","description":["Bitstream encryption is a common security mechanism provided by FPGA vendors, that lacks the secure boot of the bitstream. The implementation for Secure Boot does not extend beyond the First Stage Boot Loader. Related work such as starbleed attacks shows the second stage boot loader can be targeted to load any malicious code. we propose an architecture that mitigates the security overhead away from the application logic by proposing a two-stage secure boot mechanism. The first stage uses device bound unique response as a key to decrypt application logic. The security functionality is extended at runtime by adding logic hooks for the device specific application. The technique enables trust for the processes of secure boot and over the air updates."],"links":["https://coefs.uncc.edu/fsaqib/projects/"],"contacts":[{"name":"Fareena Saqib","email":"fsaqib@uncc.edu","affiliation":"University of North Carolina at Charlotte"}],"affiliation":"University of North Carolina at Charlotte"},{"category":"FPGA Security","vulnerability-attack":"TDC Implementation","solution-plugin":"Seek Contact","solution-status":"","licensing":"","security-metric":"Integracted logic analyzer.","security-metric-description":null,"trl":"TBD","description":["See readme.txt in file included in links."],"links":["https://www.trust-hub.org/downloads/resource/misc/TDC-implementation.rar"],"contacts":[{"name":"Farimah Farahmandi","email":"farimah@ece.ufl.edu","affiliation":"University Florida"},{"name":"Md Rafid Muttaki","email":"m.muttaki@ufl.edu","affiliation":"University Florida"}],"affiliation":"University of Florida"}]')},Oxv6:function(e,t,n){!function(e){"use strict";var t={0:"-\u0443\u043c",1:"-\u0443\u043c",2:"-\u044e\u043c",3:"-\u044e\u043c",4:"-\u0443\u043c",5:"-\u0443\u043c",6:"-\u0443\u043c",7:"-\u0443\u043c",8:"-\u0443\u043c",9:"-\u0443\u043c",10:"-\u0443\u043c",12:"-\u0443\u043c",13:"-\u0443\u043c",20:"-\u0443\u043c",30:"-\u044e\u043c",40:"-\u0443\u043c",50:"-\u0443\u043c",60:"-\u0443\u043c",70:"-\u0443\u043c",80:"-\u0443\u043c",90:"-\u0443\u043c",100:"-\u0443\u043c"};e.defineLocale("tg",{months:{format:"\u044f\u043d\u0432\u0430\u0440\u0438_\u0444\u0435\u0432\u0440\u0430\u043b\u0438_\u043c\u0430\u0440\u0442\u0438_\u0430\u043f\u0440\u0435\u043b\u0438_\u043c\u0430\u0439\u0438_\u0438\u044e\u043d\u0438_\u0438\u044e\u043b\u0438_\u0430\u0432\u0433\u0443\u0441\u0442\u0438_\u0441\u0435\u043d\u0442\u044f\u0431\u0440\u0438_\u043e\u043a\u0442\u044f\u0431\u0440\u0438_\u043d\u043e\u044f\u0431\u0440\u0438_\u0434\u0435\u043a\u0430\u0431\u0440\u0438".split("_"),standalone:"\u044f\u043d\u0432\u0430\u0440_\u0444\u0435\u0432\u0440\u0430\u043b_\u043c\u0430\u0440\u0442_\u0430\u043f\u0440\u0435\u043b_\u043c\u0430\u0439_\u0438\u044e\u043d_\u0438\u044e\u043b_\u0430\u0432\u0433\u0443\u0441\u0442_\u0441\u0435\u043d\u0442\u044f\u0431\u0440_\u043e\u043a\u0442\u044f\u0431\u0440_\u043d\u043e\u044f\u0431\u0440_\u0434\u0435\u043a\u0430\u0431\u0440".split("_")},monthsShort:"\u044f\u043d\u0432_\u0444\u0435\u0432_\u043c\u0430\u0440_\u0430\u043f\u0440_\u043c\u0430\u0439_\u0438\u044e\u043d_\u0438\u044e\u043b_\u0430\u0432\u0433_\u0441\u0435\u043d_\u043e\u043a\u0442_\u043d\u043e\u044f_\u0434\u0435\u043a".split("_"),weekdays:"\u044f\u043a\u0448\u0430\u043d\u0431\u0435_\u0434\u0443\u0448\u0430\u043d\u0431\u0435_\u0441\u0435\u0448\u0430\u043d\u0431\u0435_\u0447\u043e\u0440\u0448\u0430\u043d\u0431\u0435_\u043f\u0430\u043d\u04b7\u0448\u0430\u043d\u0431\u0435_\u04b7\u0443\u043c\u044a\u0430_\u0448\u0430\u043d\u0431\u0435".split("_"),weekdays